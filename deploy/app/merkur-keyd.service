# merkur-keyd, on the host with the app role (deploy/service-hosts.json): the OPAQUE
# server setup, the ML-DSA-87 session-capability key and the web-push VAPID key, which
# the application server uses only through keyd's socket (apps/keyd).
#
# `scripts/ci/install-app-release.sh` installs this unit, the release binary behind
# /usr/local/bin/merkur-keyd and the system user from merkur-keyd.sysusers.conf. The
# keys in /etc/merkur/keyd/ are provisioned once on the host and never leave it.
#
# keyd runs as its own static user so the server, a dynamic user in the merkur-keyd
# group, can open the socket and nothing else: the credentials, the attempt log and
# keyd's memory stay keyd's.

[Unit]
Description=Merkur key service
Documentation=https://github.com/merkur-sh/merkur

[Service]
Type=exec
User=merkur-keyd
Group=merkur-keyd
ExecStart=/usr/local/bin/merkur-keyd
Restart=always
RestartSec=2s
UMask=0077
Environment=MERKUR_KEYD_SOCKET=/run/merkur-keyd/keyd.sock

LoadCredential=opaque-server-setup:/etc/merkur/keyd/opaque-server-setup
LoadCredential=session-token-mldsa87-seed:/etc/merkur/keyd/session-token-mldsa87-seed
LoadCredential=web-push-vapid-private-key:/etc/merkur/keyd/web-push-vapid-private-key

# The socket's directory: traversable by the group, which the server holds.
RuntimeDirectory=merkur-keyd
RuntimeDirectoryMode=0750
# The attempt log, which must outlive a restart (apps/keyd/src/budget.rs).
StateDirectory=merkur-keyd
StateDirectoryMode=0700

# keyd writes no core file; it locks only the pages that hold its keys, within the default limit.
LimitCORE=0

# It speaks only over its Unix socket; it has no network at all.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
# @system-service holds the mlock, setrlimit and prctl keyd hardens itself with.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
