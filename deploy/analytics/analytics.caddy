# The analytics role: the Rybbit dashboard behind Cloudflare. The name answers
# only Cloudflare's ranges, with the zone's Origin CA certificate.
analytics.merkur.sh {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	@direct not remote_ip {$CLOUDFLARE_RANGES}
	abort @direct
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle /.well-known/oauth-* {
		reverse_proxy 127.0.0.1:3001
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:3002
	}
}
