# Inactive integration recipe. Main activates only after every qualification entry is resolved.
name: CI
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
  workflow_call:
permissions:
  contents: read
concurrency:
  group: ci-${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}
  cancel-in-progress: ${{ !startsWith(github.ref, 'refs/tags/') }}
jobs:
  plan:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    outputs:
      source: ${{ steps.plan.outputs.source }}
      native: ${{ steps.plan.outputs.native }}
      integration: ${{ steps.plan.outputs.integration }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
          fetch-depth: 2
      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6
        with:
          bun-version: 1.4.2
      - id: plan
        env:
          CI_BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: bun run scripts/ci-plan.ts
  source:
    needs: plan
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: ./.github/actions/setup-bazel
        id: engine
        with:
          ledger-origin: ${{ vars.MERKUR_VERIFICATION_LEDGER_ORIGIN }}
          ledger-credential-helper: ${{ vars.MERKUR_VERIFICATION_LEDGER_CREDENTIAL_HELPER }}
          credential-file: ${{ vars.MERKUR_VERIFICATION_CREDENTIAL_FILE }}
      - name: Require complete snapshot, static and source inventory
        run: python3 -I scripts/ci/bazel_admission.py .github/bazel/qualification.json source
      # The standing controller must own prepareVerification capabilities, durably confirm
      # the complete expected-context batch, and install final nonce/action/SDK/pool binding.
      # The setup operation provisions a fresh dedicated client from explicit operator inputs.
      # Protected HTTPS/write authentication and the helper's declared shell remain qualification
      # requirements; reading the ledger does not prove an authenticated controller service.
      # ControllerResult contains results[] plus admitted/problems; its uploaded JSON
      # and expected batch are retention only, not an owned controller handle.
      # The frontend refuses missing operations and pending trust obligations.
      # Source remains required for every event, including prose-only changes.
      # Changed-source selection includes the real-session simulator and deferred bounded
      # proofs when their implementation inputs change; missing declared producers refuse
      # controller admission instead of silently dropping those operations.
      - name: Verify the captured source through the declared frontend
        env:
          VERIFICATION_BAZEL: ${{ steps.engine.outputs.executable }}
          LEDGER_CLIENT: ${{ steps.engine.outputs.ledger-client }}
          CREDENTIAL_FILE: ${{ steps.engine.outputs.credential-file }}
          EVENT_NAME: ${{ github.event_name }}
          SOURCE_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          SOURCE_CANDIDATE_SHA: ${{ github.sha }}
        run: |
          set -euo pipefail
          [[ "$VERIFICATION_BAZEL" == /* ]]
          [[ "$LEDGER_CLIENT" == /* && "$CREDENTIAL_FILE" == /* ]]
          [[ "$SOURCE_CANDIDATE_SHA" =~ ^[0-9a-f]{40}$ ]]
          report="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.json"
          expected="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.expected-context.json"
          ci="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.ci.json"
          args=(--all --candidate "$SOURCE_CANDIDATE_SHA" --report-file "$report" --ci-report-file "$ci" --expected-context-file "$expected")
          if [[ "$EVENT_NAME" == pull_request ]]; then
            [[ "$SOURCE_BASE_SHA" =~ ^[0-9a-f]{40}$ ]]
            args=(--changed --base "$SOURCE_BASE_SHA" --candidate "$SOURCE_CANDIDATE_SHA" --report-file "$report" --ci-report-file "$ci" --expected-context-file "$expected")
          fi
          args+=(--ledger-client "$LEDGER_CLIENT" --credential-file "$CREDENTIAL_FILE")
          [[ "$TMPDIR" == "${BAZEL_OUTPUT_USER_ROOT%/bazel}/tmp" && -d "$TMPDIR" ]]
          env -i HOME="$HOME" USER="${USER:-runner}" LOGNAME="${LOGNAME:-runner}" \
            TMPDIR="${TMPDIR:?Missing owned Bazel temporary storage}" PATH=/usr/bin:/bin \
            "$VERIFICATION_BAZEL" --ignore_all_rc_files --host_jvm_args=-XX:+ExitOnOutOfMemoryError --output_user_root="$BAZEL_OUTPUT_USER_ROOT" run \
            --incompatible_strict_action_env --guard_against_concurrent_changes --remote_verify_downloads \
            --remote_download_outputs=all --symlink_prefix=/ //tools:verify -- "${args[@]}"
      - name: Require all three retained controller diagnostic Files
        if: always()
        run: |
          set -euo pipefail
          stem="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB"
          for file in "$stem.json" "$stem.expected-context.json" "$stem.ci.json"; do
            [[ -f "$file" && ! -L "$file" && -s "$file" ]]
          done
      - name: Retain the sanitized reconstructable frontend result
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: source-verification-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/merkur-verification-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.job }}.json
            ${{ runner.temp }}/merkur-verification-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.job }}.expected-context.json
            ${{ runner.temp }}/merkur-verification-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.job }}.ci.json
          if-no-files-found: error
          compression-level: 0
          retention-days: 7
      - name: Copy only reported simulation diagnostics before storage retirement
        id: simulation-artifacts
        if: always()
        env:
          VERIFICATION_BAZEL: ${{ steps.engine.outputs.executable }}
        run: |
          set -euo pipefail
          [[ "$VERIFICATION_BAZEL" == /* ]]
          [[ "$TMPDIR" == "${BAZEL_OUTPUT_USER_ROOT%/bazel}/tmp" && -d "$TMPDIR" ]]
          report="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.json"
          archive="$RUNNER_TEMP/simulation-diagnostics-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB"
          retained=$(env -i HOME="$HOME" USER="${USER:-runner}" LOGNAME="${LOGNAME:-runner}" \
            TMPDIR="${TMPDIR:?Missing owned Bazel temporary storage}" PATH=/usr/bin:/bin \
            "$VERIFICATION_BAZEL" --ignore_all_rc_files --host_jvm_args=-XX:+ExitOnOutOfMemoryError --output_user_root="$BAZEL_OUTPUT_USER_ROOT" run \
            --incompatible_strict_action_env --guard_against_concurrent_changes --remote_verify_downloads \
            --remote_download_outputs=all --symlink_prefix=/ //tools/bazel/ci:simulation_artifacts -- \
            --report-file "$report" --temporary-root "$TMPDIR" --output-directory "$archive")
          [[ -z "$retained" || ( "$retained" == /* && "$retained" == */"${archive##*/}" ) ]]
          printf 'directory=%s\n' "$retained" >> "$GITHUB_OUTPUT"
      - name: Retain reported original simulation attempt Files
        if: always() && steps.simulation-artifacts.outputs.directory != ''
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: simulation-diagnostics-${{ github.job }}-${{ strategy.job-index || 0 }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.simulation-artifacts.outputs.directory }}
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Retire the owned Bazel storage
        if: always() && env.MERKUR_BAZEL_STORAGE_STATE != ''
        shell: bash
        env:
          ENGINE: ${{ steps.engine.outputs.executable }}
        run: |
          set -euo pipefail
          shutdown_status=0
          if [[ -n "$ENGINE" && -x "$ENGINE" ]]; then
            "$ENGINE" --ignore_all_rc_files --host_jvm_args=-XX:+ExitOnOutOfMemoryError --output_user_root="$BAZEL_OUTPUT_USER_ROOT" shutdown || shutdown_status=$?
          fi
          cleanup_status=0
          python3 -I -B tools/bazel/qualification/storage/storage.py cleanup --state "$MERKUR_BAZEL_STORAGE_STATE" || cleanup_status=$?
          if (( shutdown_status != 0 || cleanup_status != 0 )); then
            echo "Owned storage retirement: Bazel shutdown exited $shutdown_status; storage cleanup exited $cleanup_status" >&2
          fi
          if (( cleanup_status != 0 )); then
            exit "$cleanup_status"
          fi
          exit "$shutdown_status"

  native:
    # Native force rotates shared epochs only after the source controller has finished.
    needs: [plan, source]
    if: needs.plan.outputs.native == 'true'
    # This runner is only the trusted controller, never the standing compiler/test pool.
    runs-on: ubuntu-24.04
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
          fetch-depth: 0
      - run: python3 -I scripts/ci/bazel_admission.py .github/bazel/qualification.json native
      - uses: ./.github/actions/setup-bazel
        id: engine
        with:
          ledger-origin: ${{ vars.MERKUR_VERIFICATION_LEDGER_ORIGIN }}
          ledger-credential-helper: ${{ vars.MERKUR_VERIFICATION_LEDGER_CREDENTIAL_HELPER }}
          credential-file: ${{ vars.MERKUR_VERIFICATION_CREDENTIAL_FILE }}
      - name: Verify the complete fresh native platform batch through the owned controller
        env:
          VERIFICATION_BAZEL: ${{ steps.engine.outputs.executable }}
          LEDGER_CLIENT: ${{ steps.engine.outputs.ledger-client }}
          CREDENTIAL_FILE: ${{ steps.engine.outputs.credential-file }}
          SOURCE_CANDIDATE_SHA: ${{ github.sha }}
          MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE: ${{ vars.MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE }}
        run: |
          set -euo pipefail
          [[ "$VERIFICATION_BAZEL" == /* ]]
          [[ "$LEDGER_CLIENT" == /* && "$CREDENTIAL_FILE" == /* ]]
          [[ "$SOURCE_CANDIDATE_SHA" =~ ^[0-9a-f]{40}$ ]]
          : "${MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE:?Missing qualified native executor policy}"
          [[ "$MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE" == /* ]]
          [[ -f "$MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE" && ! -L "$MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE" && -s "$MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE" ]]
          report="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.json"
          expected="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.expected-context.json"
          ci="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.ci.json"
          [[ "$TMPDIR" == "${BAZEL_OUTPUT_USER_ROOT%/bazel}/tmp" && -d "$TMPDIR" ]]
          env -i HOME="$HOME" USER="${USER:-runner}" LOGNAME="${LOGNAME:-runner}" \
            TMPDIR="${TMPDIR:?Missing owned Bazel temporary storage}" PATH=/usr/bin:/bin \
            "$VERIFICATION_BAZEL" --ignore_all_rc_files --host_jvm_args=-XX:+ExitOnOutOfMemoryError --output_user_root="$BAZEL_OUTPUT_USER_ROOT" run \
            --incompatible_strict_action_env --guard_against_concurrent_changes --remote_verify_downloads \
            --remote_download_outputs=all --symlink_prefix=/ //tools:verify -- --all --force \
            --native-platforms --executor-policy-file "$MERKUR_VERIFICATION_EXECUTOR_POLICY_FILE" \
            --candidate "$SOURCE_CANDIDATE_SHA" --ledger-client "$LEDGER_CLIENT" \
            --credential-file "$CREDENTIAL_FILE" --report-file "$report" \
            --ci-report-file "$ci" --expected-context-file "$expected"
      - name: Require all three retained controller diagnostic Files
        if: always()
        run: |
          set -euo pipefail
          stem="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB"
          for file in "$stem.json" "$stem.expected-context.json" "$stem.ci.json"; do
            [[ -f "$file" && ! -L "$file" && -s "$file" ]]
          done
      - name: Retain the complete native controller diagnostics
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: native-verification-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/merkur-verification-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.job }}.json
            ${{ runner.temp }}/merkur-verification-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.job }}.expected-context.json
            ${{ runner.temp }}/merkur-verification-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.job }}.ci.json
          if-no-files-found: error
          compression-level: 0
          retention-days: 7
      - name: Copy only reported simulation diagnostics before storage retirement
        id: simulation-artifacts
        if: always()
        env:
          VERIFICATION_BAZEL: ${{ steps.engine.outputs.executable }}
        run: |
          set -euo pipefail
          [[ "$VERIFICATION_BAZEL" == /* ]]
          [[ "$TMPDIR" == "${BAZEL_OUTPUT_USER_ROOT%/bazel}/tmp" && -d "$TMPDIR" ]]
          report="$RUNNER_TEMP/merkur-verification-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB.json"
          archive="$RUNNER_TEMP/simulation-diagnostics-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$GITHUB_JOB"
          retained=$(env -i HOME="$HOME" USER="${USER:-runner}" LOGNAME="${LOGNAME:-runner}" \
            TMPDIR="${TMPDIR:?Missing owned Bazel temporary storage}" PATH=/usr/bin:/bin \
            "$VERIFICATION_BAZEL" --ignore_all_rc_files --host_jvm_args=-XX:+ExitOnOutOfMemoryError --output_user_root="$BAZEL_OUTPUT_USER_ROOT" run \
            --incompatible_strict_action_env --guard_against_concurrent_changes --remote_verify_downloads \
            --remote_download_outputs=all --symlink_prefix=/ //tools/bazel/ci:simulation_artifacts -- \
            --report-file "$report" --temporary-root "$TMPDIR" --output-directory "$archive")
          [[ -z "$retained" || ( "$retained" == /* && "$retained" == */"${archive##*/}" ) ]]
          printf 'directory=%s\n' "$retained" >> "$GITHUB_OUTPUT"
      - name: Retain reported original simulation attempt Files
        if: always() && steps.simulation-artifacts.outputs.directory != ''
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: simulation-diagnostics-${{ github.job }}-${{ strategy.job-index || 0 }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.simulation-artifacts.outputs.directory }}
          if-no-files-found: error
          compression-level: 0
          retention-days: 14
      - name: Retire the owned Bazel storage
        if: always() && env.MERKUR_BAZEL_STORAGE_STATE != ''
        shell: bash
        env:
          ENGINE: ${{ steps.engine.outputs.executable }}
        run: |
          set -euo pipefail
          shutdown_status=0
          if [[ -n "$ENGINE" && -x "$ENGINE" ]]; then
            "$ENGINE" --ignore_all_rc_files --host_jvm_args=-XX:+ExitOnOutOfMemoryError --output_user_root="$BAZEL_OUTPUT_USER_ROOT" shutdown || shutdown_status=$?
          fi
          cleanup_status=0
          python3 -I -B tools/bazel/qualification/storage/storage.py cleanup --state "$MERKUR_BAZEL_STORAGE_STATE" || cleanup_status=$?
          if (( shutdown_status != 0 || cleanup_status != 0 )); then
            echo "Owned storage retirement: Bazel shutdown exited $shutdown_status; storage cleanup exited $cleanup_status" >&2
          fi
          if (( cleanup_status != 0 )); then
            exit "$cleanup_status"
          fi
          exit "$shutdown_status"

  integration:
    needs: plan
    if: needs.plan.outputs.integration == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: python3 -I scripts/ci/bazel_admission.py .github/bazel/qualification.json integration
      # Auth + rebind + reorder execute through declared browser/service fixtures.
      - name: Reject a missing execution producer
        run: |
          echo "Required: declared authenticated browser/service scenarios and receipts" >&2
          exit 1

  transport:
    needs: plan
    if: needs.plan.outputs.integration == 'true'
    strategy:
      fail-fast: false
      matrix:
        shard: [1, 2]
    runs-on: ubuntu-24.04
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - run: python3 -I scripts/ci/bazel_admission.py .github/bazel/qualification.json transport
      # Each declared shard must retain its fresh execution/scenario receipts.
      - name: Reject a missing execution producer
        run: |
          echo "Required: declared transport shard scenarios and receipts" >&2
          exit 1

  required:
    name: CI required
    if: always()
    needs: [plan, source, native, integration, transport]
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    env:
      RESULTS: ${{ toJSON(needs) }}
      SOURCE: ${{ needs.plan.outputs.source }}
      NATIVE: ${{ needs.plan.outputs.native }}
      INTEGRATION: ${{ needs.plan.outputs.integration }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      # Source and native jobs return success only after their actual controller commands
      # and complete diagnostic retention succeed. This aggregates those statuses; it
      # does not reconstruct or admit uploaded JSON as a controller capability.
      - name: Reject incomplete or failed required inventory
        run: |
          python3 -I scripts/ci/bazel_admission.py ci-results \
            "{\"source\":$SOURCE,\"native\":$NATIVE,\"integration\":$INTEGRATION}" "$RESULTS"
