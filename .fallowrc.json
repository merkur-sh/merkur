{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/natlab/run-native.ts",
    "tools/bazel/**/*.ts",
    "tests/**/*.ts",
    "apps/web/src/main.tsx",
    "apps/web/src/sw.ts",
    "apps/web/src/terminal-worker.ts",
    "uno.config.ts",
    "apps/web/vite.config.ts",
    "apps/web/uno.config.ts",
    "apps/site/src/main.ts",
    "apps/site/src/blog/page.ts",
    "apps/site/src/blog/render.tsx",
    "apps/site/blog/posts/*/cover.tsx",
    "apps/site/blog/posts/*/figures/*.tsx",
    "apps/site/blog/posts/*/figures/*.test.ts",
    "apps/site/fixtures/blog/posts/*/cover.tsx",
    "apps/site/fixtures/blog/posts/*/figures/*.tsx",
    "apps/site/fixtures/blog/posts/*/figures/*.test.ts",
    "apps/site/server/index.ts",
    "apps/site/server/build.ts",
    "apps/site/server/*.test.ts",
    "apps/site/scripts/*.ts",
    "apps/site/vite.config.ts",
    "apps/site/uno.config.ts",
    "apps/server/src/index.ts",
    "apps/*/src/**/*.test.ts",
    "apps/server/scripts/*.ts",
    "apps/server/migrations/*.ts",
    "apps/daemon/src/index.ts",
    "packages/*/src/index.ts",
    "packages/*/src/*.test.ts",
    "packages/merkur-client-native/scripts/browser-registration-oracle.ts"
  ],
  "dynamicallyLoaded": [
    "apps/web/public/legal/legal.css",
    "apps/site/src/blog/blog.css",
    "apps/site/blog/**/*.mdx",
    "apps/site/fixtures/blog/**/*.mdx",
    "playwright.edge-topology.config.mjs",
    "scripts/natlab/playwright.native.config.mjs",
    "spikes/webtransport-ios/worker/main.ts",
    "spikes/webtransport-ios/worker/drain-worker.ts"
  ],
  "ignorePatterns": ["tools/codeql/*/test/**"],
  "includeEntryExports": true,
  "publicPackages": ["@merkur/keyboard"],
  "ignoreDependencies": ["bench-web-input-v8:keybinds"],
  "ignoreExports": [
    {
      "file": "scripts/perf/historical-webgl-module.d.ts",
      "exports": ["WebGl2Renderer", "createTaskPollScheduler"]
    },
    {
      "file": "apps/daemon/src/text-imports.d.ts",
      "exports": ["default"]
    },
    {
      "file": "apps/server/src/services/mail-lockup.png.d.ts",
      "exports": ["default"]
    },
    {
      "file": "apps/server/migrations/*.ts",
      "exports": ["up", "down"]
    },
    {
      "file": "playwright.*.config.mjs",
      "exports": ["default"]
    },
    {
      "file": "scripts/natlab/playwright.native.config.mjs",
      "exports": ["default"]
    },
    {
      "file": "tests/e2e/global-setup.ts",
      "exports": ["default"]
    },
    {
      "file": "tests/e2e/global-teardown.ts",
      "exports": ["default"]
    },
    {
      "file": "uno.config.ts",
      "exports": ["default"]
    },
    {
      "file": "apps/site/uno.config.ts",
      "exports": ["default"]
    },
    {
      "file": "apps/site/src/blog/render.tsx",
      "exports": ["renderPost", "renderIndex", "renderPolicy", "renderFeedContent"]
    },
    {
      "file": "apps/site/src/blog/islands.d.ts",
      "exports": ["islands"]
    },
    {
      "file": "apps/site/{blog,fixtures/blog}/posts/*/{cover,figures/*}.tsx",
      "exports": ["default"]
    }
  ],
  "ignoreExportsUsedInFile": true,
  "duplicates": {
    "ignore": ["apps/server/migrations/**"],
    "threshold": 10.0
  },
  "health": {
    "maxCyclomatic": 33,
    "maxCognitive": 45,
    "maxCrap": 1057.0
  },
  "overrides": [
    {
      "files": ["apps/server/src/db/generated-types.ts"],
      "rules": {
        "unused-exports": "off",
        "unused-types": "off"
      }
    }
  ]
}
