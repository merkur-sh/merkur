load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

# Links the Swift runtime path merkur-identity-seal publishes.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    edition = "2024",
    deps = ["//packages/merkur-identity-seal:merkur_identity_seal"],
)

_DEPS = [
    "//packages/alacritty-terminal-patch:alacritty_terminal",
    "//packages/merkur-authorization:merkur_authorization",
    "//packages/merkur-client:merkur_client",
    "//packages/merkur-client-native:merkur_client_native",
    "//packages/merkur-graphics:merkur_graphics",
    "//packages/merkur-identity-seal:merkur_identity_seal",
    "//packages/merkur-wire:merkur_wire",
    "//packages/term-wasm:term_wasm",
]

rust_library(
    name = "merkur_tui",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":build_script"] + _DEPS + all_crate_deps(normal = True),
)

rust_binary(
    name = "merkur-tui",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/main.rs",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        ":build_script",
        ":merkur_tui",
    ] + _DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_tui",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = ["//packages/merkur-codec:merkur_codec"] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "bin_unit",
    crate = ":merkur-tui",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = ["//packages/merkur-codec:merkur_codec"] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "interactive_host",
    srcs = ["tests/interactive_host.rs"],
    data = [":merkur-tui"],
    lint_config = ":lints",
    rustc_env = {"CARGO_BIN_EXE_merkur-tui": "$(rootpath :merkur-tui)"},
    deps = [
        ":merkur_tui",
        "//packages/merkur-codec:merkur_codec",
    ] + _DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Its live case is ignored here; the edge harness runs it against a fresh account and names
# the binary and the account.
rust_test(
    name = "interactive_live",
    srcs = ["tests/interactive_live.rs"],
    data = ["tests/pty_bridge.py"],
    lint_config = ":lints",
    deps = [
        ":merkur_tui",
        "//packages/merkur-codec:merkur_codec",
    ] + _DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_tui",
)
