load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel:files.bzl", "IGNORED", "package_files")
load("//tools/bazel/bun:bun.bzl", "bun_test_files")

package(default_visibility = ["//visibility:public"])

package_files()

npm_link_all_packages(name = "node_modules")

# The workspace package as pnpm links it into its dependents: every file it ships beside its
# `package.json`, with its own dependencies.
js_library(
    name = "pkg",
    srcs = glob(
        ["**"],
        exclude = IGNORED + ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
    deps = [":node_modules"],
)

# The tests that run the real merkur-keyd (`src/services/keyd-test-support.ts`).
_KEYD = {"tools": {"//apps/keyd:merkur-keyd": "merkur-keyd"}}

bun_test_files(
    files = {
        test: _KEYD
        for test in [
            "src/http/routes/auth-routes.test.ts",
            "src/http/routes/session-routes.test.ts",
            "src/services/account-deletion-sweep.test.ts",
            "src/services/auth-service-account.test.ts",
            "src/services/auth-service-email.test.ts",
            "src/services/auth-service-password.test.ts",
            "src/services/auth-service-reset.test.ts",
            "src/services/auth-service.test.ts",
            "src/services/key-service.keyd.test.ts",
            "src/services/push-notification-service.test.ts",
            "src/services/session-service.test.ts",
        ]
    },
    tests = glob(
        ["**/*.test.ts"],
        exclude = IGNORED,
    ),
)
