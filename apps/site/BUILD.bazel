load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel:files.bzl", "IGNORED", "package_files")
load("//tools/bazel/bun:bun.bzl", "bun_test_files")

package(default_visibility = ["//visibility:public"])

package_files()

npm_link_all_packages(name = "node_modules")

# The workspace package as pnpm links it into its dependents: every file it ships beside its
# `package.json`, with its own dependencies.
js_library(
    name = "pkg",
    srcs = glob(
        ["**"],
        exclude = IGNORED + ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
    deps = [":node_modules"],
)

bun_test_files(
    files = {
        # The static server, which these build and run.
        "server/build.test.ts": {"data": [":server/index.ts.module"]},
        "server/config.test.ts": {"data": [":server/index.ts.module"]},
        # Every page, each of which names its figures.
        "src/vite/figures.test.ts": {"data": glob(["*.html"])},
        # The facts the security page states, from where each is kept.
        "src/vite/page-facts.test.ts": {"data": [
            "//:SECURITY.md.module",
            "//apps/server:src/services/machine-usage.ts.module",
        ]},
    },
    tests = glob(
        ["**/*.test.ts"],
        exclude = IGNORED,
    ),
)
