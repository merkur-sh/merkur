# Replaces the root .dockerignore for apps/site/Dockerfile. Deny by default:
# the site's own inputs, the few files it reads from the rest of the repository,
# and the exported site-deployment directory the runner stage packages.
**

# Workspace manifests and build configuration.
!package.json
!bun.lock
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json

# The site: pages, styles, pictures, faces and the server.
!apps/site/**

# What the site builds with: the design system and the logger.
!packages/quicksilver/**
!packages/logger/**

# Facts the pages state and do not own: the release-key fingerprint, the legal
# text, and the machine limit; and the face the terminal marks were cut from.
!SECURITY.md
!apps/web/public/legal/*.html
!apps/server/src/services/machine-usage.ts
!apps/web/public/fonts/JetBrainsMonoNF-Regular.ttf

!scripts/compress-site.ts

# Never generated copies or development credentials.
**/node_modules
**/dist
**/*.test.ts
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.seed

# Packaging input for the runner stage: the exported executable and dist,
# admitted after the `**/dist` rule above.
!site-deployment/**
