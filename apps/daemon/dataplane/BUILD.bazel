load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/bazel/rust:defs.bzl", "rust_e2e_testing_binary", "rust_e2e_testing_test")
load("//tools/bazel:files.bzl", "package_files")
load("//tools/bazel/release:defs.bzl", "release_binary")

package(default_visibility = ["//visibility:public"])

package_files()

# The crate's sources and root, which the simulator's crate hub compiles too
# (`//tools/bazel/sim`).
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

# Links the Swift runtime path merkur-identity-seal publishes.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    edition = "2024",
    deps = ["//packages/merkur-identity-seal:merkur_identity_seal"],
)

_DEPS = [
    ":build_script",
    "//packages/alacritty-terminal-patch:alacritty_terminal",
    "//packages/merkur-authorization:merkur_authorization",
    "//packages/merkur-codec:merkur_codec",
    "//packages/merkur-e2e:merkur_e2e",
    "//packages/merkur-edge-protocol:merkur_edge_protocol",
    "//packages/merkur-fec:merkur_fec",
    "//packages/merkur-graphics:merkur_graphics",
    "//packages/merkur-identity-seal:merkur_identity_seal",
    "//packages/merkur-image-worker:merkur_image_worker",
    "//packages/merkur-stun-protocol:merkur_stun_protocol",
    "//packages/merkur-trace:merkur_trace",
    "//packages/merkur-traversal:merkur_traversal",
    "//packages/merkur-wire:merkur_wire",
]

_DEV_DEPS = [
    "//packages/merkur-client:merkur_client",
    "//packages/term-wasm:term_wasm",
]

_COMPILE_DATA = [
    "//packages/shared:test_vectors",
    "//tests:kitty_fixtures",
]

rust_library(
    name = "merkur_dataplane",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = _COMPILE_DATA,
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _DEPS + all_crate_deps(normal = True),
)

rust_binary(
    name = "merkur-dataplane",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/main.rs",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":merkur_dataplane"] + _DEPS + all_crate_deps(normal = True),
)

# The suite builds with merkur-e2e's `testing` vector helpers, and drives the image helper this
# graph builds: the real-helper tests take its path from `MERKUR_IMAGE_WORKER`. The helper
# confines itself with the operating system's sandbox, which macOS refuses to nest inside
# Bazel's, so the suite runs unsandboxed.
rust_e2e_testing_test(
    name = "unit",
    compile_data = _COMPILE_DATA,
    crate = ":merkur_dataplane",
    data = ["//packages/merkur-image-worker:merkur-image-worker"],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"MERKUR_IMAGE_WORKER": "$(rootpath //packages/merkur-image-worker:merkur-image-worker)"},
    tags = ["no-sandbox"],
    deps = _DEV_DEPS + all_crate_deps(normal_dev = True),
)

# The unit suite in Cargo's release profile, whatever the command line's configuration: the
# `bench:*` scripts run its ignored benchmarks with
# `bazel run //apps/daemon/dataplane:unit_release -- --ignored --exact <benchmark>`.
release_binary(
    name = "unit_release",
    testonly = True,
    binary = ":unit",
    tags = ["manual"],
)

# The unit suite's harness as a binary, for the profile-guided release build to train on
# (`//tools/bazel/release:dataplane_profile`): a test target cannot feed a shipped one. Only the
# release builds it, by name.
rust_e2e_testing_binary(
    name = "training",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = _COMPILE_DATA,
    crate_root = "src/lib.rs",
    data = ["//packages/merkur-image-worker:merkur-image-worker"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"MERKUR_IMAGE_WORKER": "$(rootpath //packages/merkur-image-worker:merkur-image-worker)"},
    rustc_flags = ["--test"],
    tags = [
        "manual",
        "noclippy",
    ],
    deps = _DEPS + _DEV_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_e2e_testing_test(
    name = "bin_unit",
    crate = ":merkur-dataplane",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = _DEV_DEPS + all_crate_deps(normal_dev = True),
)

# The upgrade end to end (`tests/handoff.rs`): the shipped binary hands a live shell to its
# successor across `execve`, the test playing the owner that replaced itself.
rust_test(
    name = "handoff",
    srcs = ["tests/handoff.rs"],
    data = [":merkur-dataplane"],
    lint_config = ":lints",
    rustc_env = {"MERKUR_DATAPLANE_BIN": "$(rootpath :merkur-dataplane)"},
    tags = ["no-sandbox"],
    deps = all_crate_deps(normal = True),
)

[rust_binary(
    name = "bench_" + bench,
    srcs = ["benches/%s.rs" % bench],
    lint_config = ":lints",
    deps = [":merkur_dataplane"] + _DEPS + _DEV_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
) for bench in [
    "fec",
]]
