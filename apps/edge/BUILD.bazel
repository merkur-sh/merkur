load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

_DEPS = ["//packages/merkur-edge-protocol:merkur_edge_protocol"]

rust_library(
    name = "merkur_edge",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _DEPS + all_crate_deps(normal = True),
)

rust_binary(
    name = "merkur-edge",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    aliases = aliases(),
    crate_root = "src/main.rs",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":merkur_edge"] + _DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_edge",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "bin_unit",
    crate = ":merkur-edge",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_edge",
)

# The diagnostic peers and their tests. `relay_profile` builds only with the `profiling`
# feature (Cargo's `required-features`), which the lint set does not take.
[[
    rust_binary(
        name = name,
        srcs = glob(
            [
                "src/attach_ticket.rs",
                "src/bin/%s.rs" % name,
                "src/bin/%s/**/*.rs" % name,
            ],
            allow_empty = True,
        ),
        aliases = aliases(),
        crate_features = ["profiling"] if name == "relay_profile" else [],
        crate_root = "src/bin/%s.rs" % name,
        lint_config = ":lints",
        proc_macro_deps = all_crate_deps(proc_macro = True),
        tags = ["noclippy"] if name == "relay_profile" else [],
        deps = [":merkur_edge"] + _DEPS + all_crate_deps(normal = True),
    ),
    rust_test(
        name = name + "_unit",
        crate = ":" + name,
        crate_features = ["profiling"] if name == "relay_profile" else [],
        lint_config = ":lints",
        proc_macro_deps = all_crate_deps(proc_macro_dev = True),
        tags = ["noclippy"] if name == "relay_profile" else [],
        deps = all_crate_deps(normal_dev = True),
    ),
] for name in [
    "bulk_competitor",
    "delay_proxy",
    "hol_probe",
    "migration_probe",
    "probe",
    "relay_profile",
]]
