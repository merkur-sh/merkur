load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel:files.bzl", "IGNORED", "package_files")
load("//tools/bazel/wasm:defs.bzl", "wasm_package_files")
load("//tools/bazel/bun:bun.bzl", "bun_test_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The terminal fonts, which the terminal crate embeds in its tests and atlas profile, and the
# subset manifest beside them, which the font tests and the display benchmarks read.
filegroup(
    name = "fonts",
    srcs = glob(["public/fonts/**"]),
)

# The face the terminal's profile-guided build trains on, and the receiver calibration's MZ
# fixtures, which `//packages/display-fixture` checks against the model.
exports_files([
    "public/fonts/JetBrainsMonoNF-Regular.ttf",
    "src/terminal/display-receiver-calibration-fixtures.ts",
])

npm_link_all_packages(name = "node_modules")

# The workspace package as pnpm links it into its dependents: every file it ships beside its
# `package.json`, with its own dependencies.
js_library(
    name = "pkg",
    srcs = glob(
        ["**"],
        exclude = IGNORED + ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
    deps = [":node_modules"],
)

# The terminal module where the app imports it from.
wasm_package_files(
    name = "term_wasm_files",
    directory = "src/term-wasm/pkg",
    package = "//tools/bazel/wasm/term-wasm:imported_pkg",
)

bun_test_files(
    files = {"src/terminal/fonts.test.ts": {"data": [":fonts"]}},
    tests = glob(
        ["**/*.test.ts"],
        exclude = IGNORED,
    ),
)
