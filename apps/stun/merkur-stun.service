# The STUN responder on a service host (deploy/service-hosts.json).
#
# One process binds the host's public IPv4 and two addresses out of its routed
# IPv6 /64 (MERKUR_STUN_BIND, rendered into /etc/merkur/stun.env). The IPv4's
# ports answer the port-change half of RFC 5780; the IPv6 pair answers both
# halves, which matters because IPv6 has no NAT: whether a `host6` candidate is
# dialable turns entirely on whether the CPE firewall passes a datagram from an
# address the daemon never spoke to, which is the one thing `change_ip` tests.
# A changed-address answer is sent from the sibling socket, so every address
# belongs to this one process.
#
# `scripts/ci/install-service-release.sh` installs this unit, the release binary
# and the rendered /etc/merkur/stun.env on every release.
# /etc/merkur/stun.secrets.env is provisioned once on the host and never leaves
# it: MERKUR_STUN_TICKET_KEY, the same secret as the server's STUN_TICKET_KEY.

[Unit]
Description=Merkur STUN responder
Documentation=https://github.com/merkur-sh/merkur
After=network-online.target merkur-stun-addrs.service
Wants=network-online.target
Requires=merkur-stun-addrs.service

[Service]
Type=exec
EnvironmentFile=/etc/merkur/stun.env
EnvironmentFile=/etc/merkur/stun.secrets.env
ExecStart=/usr/local/bin/merkur-stun
Restart=always
RestartSec=2s

# This process is reachable by anyone with a UDP socket and holds no state, so
# it gets nothing it does not need. It does not read the filesystem, does not
# need a writable home, and never executes anything.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

[Install]
WantedBy=multi-user.target
