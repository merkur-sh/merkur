# The STUN responder's floating IPv4 and two IPv6 addresses, made to survive a
# reboot.
#
# Each family needs a second observer address: a daemon proves its mapping
# endpoint-independent only from two addresses, and only another address
# answers the address-change half of RFC 5780. Hetzner routes the floating IPv4
# to the host without configuring it, and routes each host a /64 of which the
# host uses one address, so the responder's extra addresses are added here. Addresses
# added with a bare `ip -6 addr add` are runtime state that a reboot discards,
# which would leave MERKUR_STUN_BIND naming addresses that no longer exist, so a
# oneshot ordered before the responder re-adds them on every boot. That also
# makes them assertable: `systemctl is-active merkur-stun-addrs` has an answer.
#
# The addresses come from /etc/merkur/stun.env, rendered per host from
# deploy/service-hosts.json.

[Unit]
Description=Merkur STUN vantage addresses
Documentation=https://github.com/merkur-sh/merkur
After=network-online.target
Wants=network-online.target
# The responder binds these addresses, so it must not start before they exist.
Before=merkur-stun.service

[Service]
Type=oneshot
# The addresses are the unit's whole product; without this systemd would
# consider the unit inactive the moment `ip` exits and re-run it on every
# dependency activation.
RemainAfterExit=yes
EnvironmentFile=/etc/merkur/stun.env

# `replace` rather than `add`: adding an address that is already present exits
# non-zero, which would make a re-run of an enabled unit a failure rather than
# a no-op. Each ${VAR} is substituted as a single argument, so no shell is
# involved and the values need no quoting.
ExecStart=/usr/sbin/ip -4 addr replace ${MERKUR_STUN_ADDR_V4} dev ${MERKUR_STUN_IFACE}
ExecStart=/usr/sbin/ip -6 addr replace ${MERKUR_STUN_ADDR_A} dev ${MERKUR_STUN_IFACE}
ExecStart=/usr/sbin/ip -6 addr replace ${MERKUR_STUN_ADDR_B} dev ${MERKUR_STUN_IFACE}

# Deliberately no ExecStop: tearing the addresses down because a unit was
# restarted would take the responder's vantage points away from it mid-probe.

[Install]
WantedBy=multi-user.target
