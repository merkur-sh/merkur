load("//tools/bazel/bun:rules.bzl", "bun_binary")
load(":runtime.bzl", "development_runtime")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "verification_inputs",
    srcs = ["BUILD.bazel", "runtime.bzl"],
)

development_runtime(
    name = "runtime_inputs",
    data = [
        "//apps/server:sources",
        "//apps/server:raw_sources",
        "//apps/daemon:sources",
        "//apps/daemon:raw_sources",
        "//apps/web:sources",
        "//apps/web:raw_sources",
        "//scripts:sources",
        "//scripts:raw_sources",
        "//:js_configuration",
        "//:node_modules",
        "//packages/e2e-wasm:wasm_artifacts",
        "//apps/web:term_wasm_runtime",
        "//apps/web:e2e_wasm_runtime",
        "//apps/web:graphics_wasm_runtime",
    ],
    workspace_sources = [
        "//apps/server:raw_sources",
        "//apps/daemon:raw_sources",
        "//apps/web:raw_sources",
        "//scripts:raw_sources",
        "//:js_configuration",
    ],
    config = "//tools/bazel/bun:empty-bunfig.toml",
    vite = "//tools/bazel/bun:vite_original_source_build",
    tags = ["manual", "unqualified-development-runtime"],
)

bun_binary(
    name = "stack",
    entry_point = "//tools/bazel/verification:dev-stack.ts",
    data = [
        "//tools/bazel/verification:tooling_sources",
        "//scripts:sources",
        "//scripts:raw_sources",
        "//:node_modules",
        "//packages/e2e-wasm:wasm_artifacts",
    ],
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
    tools = {
        "//tools/bazel/tools/engine:bazel": "bazel",
        "//tools/bazel/tools:git": "git",
        "//tools/bazel/credentials:buildbuddy": "buildbuddy-credentials",
    },
    tool_environment = {
        "bazel": "MERKUR_VERIFICATION_BAZEL",
        "git": "MERKUR_VERIFICATION_GIT",
        "buildbuddy-credentials": "MERKUR_VERIFICATION_CREDENTIAL_HELPER",
    },
    environment_files = {
        "//tools/bazel/tools/engine:acquisition": "MERKUR_VERIFICATION_BAZEL_ACQUISITION",
    },
    tags = ["manual", "unqualified-development-runtime"],
)
