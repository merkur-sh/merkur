startup --host_jvm_args=-XX:+ExitOnOutOfMemoryError

build --incompatible_strict_action_env
# No `bazel-*` links in the checkout: Biome, fallow, the doc checks and every other tree walk see
# sources only. `bazel info output_path` names Bazel's outputs.
build --symlink_prefix=/
test --test_output=errors

# `fastbuild`, what `bazel build` and `bazel test` use, is Cargo's test profile: first-party crates
# at opt-level 1 (`MODULE.bazel`) with line tables and every assertion on, dependencies at
# opt-level 3 with no debuginfo. `--config=release` is Cargo's release profile.
build --@rules_rust//rust/settings:extra_rustc_flags=-Cdebug-assertions=on,-Coverflow-checks=on,-Cdebuginfo=line-tables-only
build --@rules_rust//rust/settings:per_crate_rustc_flag=external/@-Copt-level=3
build --@rules_rust//rust/settings:per_crate_rustc_flag=external/@-Cdebuginfo=0
build:release --compilation_mode=opt
build:release --@rules_rust//rust/settings:extra_rustc_flags=

# Clippy, which `bun run rust:lint` runs over every first-party target: the repository's
# `clippy.toml` and JSON diagnostics for the ratchet to read. The script hands Clippy the
# ratcheted lints itself.
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:clippy_output_diagnostics=true

# Target platforms. The host is the default; these name another one to build for.
build:linux_x86_64 --platforms=//tools/bazel/platforms:linux_x86_64
build:linux_aarch64 --platforms=//tools/bazel/platforms:linux_aarch64
build:macos_x86_64 --platforms=//tools/bazel/platforms:macos_x86_64
build:macos_aarch64 --platforms=//tools/bazel/platforms:macos_aarch64

# BuildBuddy's remote cache. A workstation reads what CI wrote and uploads nothing; CI is the
# only writer. `.bazelrc.local` (ignored) enables it with `common --config=remote-cache` and the
# `--remote_header=x-buildbuddy-api-key=...` line; CI writes the same from its secret.
common:remote-cache --remote_cache=grpcs://remote.buildbuddy.io
common:remote-cache --remote_timeout=600
common:remote-cache --noremote_upload_local_results
# A workstation edits main-repository sources mid-build; `lite` guards exactly those, where
# full guarding also skips uploads of external and generated inputs whose ctime Linux reports late.
common:remote-cache --guard_against_concurrent_changes=lite
common:ci --config=remote-cache
common:ci --remote_upload_local_results
common:ci --bes_backend=grpcs://remote.buildbuddy.io
common:ci --bes_results_url=https://app.buildbuddy.io/invocation/
common:ci --color=yes
common:ci --curses=no

try-import %workspace%/.bazelrc.local
