startup --host_jvm_args=-XX:+ExitOnOutOfMemoryError

build --incompatible_strict_action_env
# No `bazel-*` links in the checkout: Biome, fallow, the doc checks and every other tree walk see
# sources only. `bazel info output_path` names Bazel's outputs.
build --symlink_prefix=/
test --test_output=errors
# A test command builds what its tests need and nothing else: the release programs, the syncs and
# the profile-guided builds `//...` also names are `bazel build`'s and the artifacts jobs'.
test --build_tests_only

# The edit loop: every test but those of the repository as a whole (the static gates' whole-tree
# checks and the tests that read every file), which rerun after any edit and are the push's to run.
# `bazel test --config=quick //...`, or `bun run test:quick`.
test:quick --test_tag_filters=-repository

# `fastbuild`, what `bazel build` and `bazel test` use, is Cargo's test profile: first-party crates
# at opt-level 1 (`MODULE.bazel`) with line tables and every assertion on, dependencies at
# opt-level 3 with no debuginfo. `--config=release` is Cargo's release profile.
build --@rules_rust//rust/settings:extra_rustc_flags=-Cdebug-assertions=on,-Coverflow-checks=on,-Cdebuginfo=line-tables-only
build --@rules_rust//rust/settings:per_crate_rustc_flag=external/@-Copt-level=3
build --@rules_rust//rust/settings:per_crate_rustc_flag=external/@-Cdebuginfo=0
build:release --compilation_mode=opt
build:release --@rules_rust//rust/settings:extra_rustc_flags=

# Incremental compilation of the workspace's crates, which a workstation enables with
# `common --config=incremental` in `.bazelrc.local`: rustc keeps each crate's state in the output
# base (`../../rust-incremental` from the execution root, about 1 GB for the dataplane) and
# recompiles what an edit reached, so a one-function dataplane edit rebuilds the test binary in
# 9 s rather than 22 s. The state needs rustc's working directory to stay put, so rustc runs
# outside the sandbox. The flag is in these crates' keys, so their results are local work, never
# CI's; CI stays sandboxed and non-incremental. Release builds leave it out
# (`tools/bazel/release/defs.bzl`), as Cargo's release profile does.
#
# Compilation is not pipelined, here or on CI: a pipelined crate's full compile also writes the
# metadata file its metadata action declares, which only a sandbox keeps apart, and every other
# Rust action's key must be the same here as on CI for the remote cache to answer it.
common:incremental --@rules_rust//rust/settings:per_crate_rustc_flag=apps/@-Cincremental=../../rust-incremental
common:incremental --@rules_rust//rust/settings:per_crate_rustc_flag=packages/@-Cincremental=../../rust-incremental
common:incremental --strategy=Rustc=local

# Clippy, which `//:rust_lint` runs over every first-party target: the repository's
# `clippy.toml`, JSON diagnostics for the ratchet to read, and each lint `scripts/rust-lint.ts`
# ratchets as a warning. The test fails unless these are exactly the script's `RATCHETED_LINTS`.
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:clippy_output_diagnostics=true
# Clippy's rendered findings go to a file beside the diagnostics, not the build's output.
build --@rules_rust//rust/settings:capture_clippy_output=true
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::cast_possible_truncation
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::cast_possible_wrap
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::cast_sign_loss
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::expect_used
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::get_unwrap
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::indexing_slicing
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::let_underscore_must_use
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::map_err_ignore
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::panic
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::string_slice
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::too_many_lines
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::unreachable
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::unused_result_ok
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::unwrap_in_result
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::unwrap_used
build --@rules_rust//rust/settings:clippy_flag=-Wclippy::wildcard_enum_match_arm

# Target platforms. The host is the default; these name another one to build for.
build:linux_x86_64 --platforms=//tools/bazel/platforms:linux_x86_64
build:linux_aarch64 --platforms=//tools/bazel/platforms:linux_aarch64
build:macos_x86_64 --platforms=//tools/bazel/platforms:macos_x86_64
build:macos_aarch64 --platforms=//tools/bazel/platforms:macos_aarch64

# The oldest macOS the daemon runs on (`docs/requirements.md`), for what ships and for the tools
# the build itself runs. Unset, it is the selected SDK's version, which every macOS link then
# records, and through `process_wrapper` every Rust action's key.
build --macos_minimum_os=13.0
build --host_macos_minimum_os=13.0

# BuildBuddy's remote cache. A workstation reads what CI wrote and uploads nothing; CI is the
# only writer. `.bazelrc.local` (ignored) enables it with `common --config=remote-cache` and the
# `--remote_header=x-buildbuddy-api-key=...` line; CI writes the same from its secret.
common:remote-cache --remote_cache=grpcs://remote.buildbuddy.io
common:remote-cache --remote_timeout=600
common:remote-cache --noremote_upload_local_results
# A workstation edits main-repository sources mid-build; `lite` guards exactly those, where
# full guarding also skips uploads of external and generated inputs whose ctime Linux reports late.
common:remote-cache --guard_against_concurrent_changes=lite
common:ci --config=remote-cache
common:ci --remote_upload_local_results
# A remote cache lookup waits on the network, about half a second from a runner; with one action in
# flight per CPU, the lookups held a four-CPU runner to well under half its CPUs. The CPU and memory
# each action reserves still bound what runs locally.
common:ci --jobs=32
# A runner's tests need nothing the remote cache answers on its disk: the outputs a local action
# reads are all it downloads, where the default downloaded every cached test's binaries and
# runfiles, over a thousand files a job.
test:ci --remote_download_minimal

# One action cache for every checkout and worktree on a machine, so a new worktree starts from what
# the others built. Bazel collects it past these bounds while idle. A CI runner starts empty and
# ends with the job, so it keeps none.
common --disk_cache=~/.cache/merkur-bazel/disk
common --experimental_disk_cache_gc_max_size=30G
common --experimental_disk_cache_gc_max_age=14d
common:ci --disk_cache=
common:ci --bes_backend=grpcs://remote.buildbuddy.io
common:ci --bes_results_url=https://app.buildbuddy.io/invocation/
common:ci --color=yes
common:ci --curses=no

try-import %workspace%/.bazelrc.local
