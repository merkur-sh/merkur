load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

# On macOS the Secure Enclave bridge is Swift, compiled with the selected Xcode's tools.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    data = ["src/macos.swift"],
    edition = "2024",
    links = "merkur_identity_seal",
    use_default_shell_env = True,
)

rust_library(
    name = "merkur_identity_seal",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        ":build_script",
        "//packages/merkur-authorization:merkur_authorization",
        "//packages/merkur-e2e:merkur_e2e",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_identity_seal",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_identity_seal",
)
