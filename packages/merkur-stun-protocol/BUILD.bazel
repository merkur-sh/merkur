load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/bazel:files.bzl", "package_files")

package_files()

# The crate's sources and root, which the simulator's crate hub compiles too
# (`//tools/bazel/sim`).
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "merkur_stun_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "merkur_stun_protocol",
    lint_config = ":lints",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_stun_protocol",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)
