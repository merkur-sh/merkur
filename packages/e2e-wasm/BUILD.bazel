load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//tools/bazel/wasm:defs.bzl", "wasm_package_files")
load("//tools/bazel:files.bzl", "IGNORED", "package_files")
load("//tools/bazel/bun:bun.bzl", "bun_test_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The crate's sources, which the browser build in `//tools/bazel/wasm` compiles too.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "e2e_wasm",
    srcs = [":srcs"],
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//packages/merkur-authorization:merkur_authorization",
        "//packages/merkur-client:merkur_client",
        "//packages/merkur-e2e:merkur_e2e",
        "//packages/merkur-edge-protocol:merkur_edge_protocol",
        "//packages/merkur-wire:merkur_wire",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":e2e_wasm",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":e2e_wasm",
)

# The browser module where the TypeScript that loads it imports it from, `pkg/`.
wasm_package_files(
    name = "pkg_files",
    package = "//tools/bazel/wasm/e2e-wasm:pkg",
)

bun_test_files(
    # The Noise vector the native build pins too.
    files = {"conformance.test.ts": {"data": [
        "//packages/shared:test-vectors/noise-xxpsk3.json.module",
    ]}},
    tests = glob(
        ["**/*.test.ts"],
        exclude = IGNORED,
    ),
)
