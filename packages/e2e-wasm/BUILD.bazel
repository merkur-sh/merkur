load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "e2e_wasm",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//packages/merkur-authorization:merkur_authorization",
        "//packages/merkur-client:merkur_client",
        "//packages/merkur-e2e:merkur_e2e",
        "//packages/merkur-edge-protocol:merkur_edge_protocol",
        "//packages/merkur-wire:merkur_wire",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":e2e_wasm",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":e2e_wasm",
)
