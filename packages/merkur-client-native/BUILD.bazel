load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//tools/bazel/bun:bun.bzl", "bun_binary")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The crate's sources and root, which the simulator's crate hub compiles too
# (`//tools/bazel/sim`).
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "merkur_client_native",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//packages/merkur-authorization:merkur_authorization",
        "//packages/merkur-client:merkur_client",
        "//packages/merkur-e2e:merkur_e2e",
        "//packages/merkur-edge-protocol:merkur_edge_protocol",
        "//packages/merkur-stun-protocol:merkur_stun_protocol",
        "//packages/merkur-traversal:merkur_traversal",
        "//packages/merkur-wire:merkur_wire",
        "//packages/term-wasm:term_wasm",
    ] + all_crate_deps(normal = True),
)

# The browser's account registration, run in Bun, which the native sign-in test signs in against.
bun_binary(
    name = "browser_registration_oracle",
    data = [
        "//:typescript_config",
        "//apps/web:pkg",
        "//packages/auth:pkg",
    ],
    entry = "scripts/browser-registration-oracle.ts",
)

rust_test(
    name = "unit",
    crate = ":merkur_client_native",
    data = [":browser_registration_oracle"],
    lint_config = ":lints",
    rustc_env = {"MERKUR_BROWSER_REGISTRATION_ORACLE": "$(rootpath :browser_registration_oracle)"},
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = ["//packages/merkur-codec:merkur_codec"] + all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_client_native",
)
