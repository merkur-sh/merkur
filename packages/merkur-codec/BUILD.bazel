load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# The crate's sources, which the browser build in `//tools/bazel/wasm` compiles too.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

_DEPS = [
    "//packages/alacritty-terminal-patch:alacritty_terminal",
    "//packages/merkur-graphics:merkur_graphics",
]

rust_library(
    name = "merkur_codec",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_codec",
    data = ["//packages/shared:test_vectors"],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

[rust_test(
    name = test,
    srcs = ["tests/%s.rs" % test],
    lint_config = ":lints",
    deps = [":merkur_codec"] + _DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
) for test in [
    "cell_repr_equivalence",
    "kernel_profile",
]]

rust_doc_test(
    name = "doc",
    crate = ":merkur_codec",
)

rust_binary(
    name = "bench_codec",
    srcs = ["benches/codec.rs"],
    lint_config = ":lints",
    deps = [":merkur_codec"] + _DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
