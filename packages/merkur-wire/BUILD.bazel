load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

_DEPS = [
    "//packages/merkur-authorization:merkur_authorization",
    "//packages/merkur-codec:merkur_codec",
]

rust_library(
    name = "merkur_wire",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//packages/shared:test_vectors"],
    crate_features = [
        "default",
        "std",
    ],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_wire",
    crate_features = [
        "default",
        "std",
    ],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = ["//packages/vte-patch:vte"] + all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_wire",
    crate_features = [
        "default",
        "std",
    ],
)
