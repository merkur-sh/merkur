load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//tools/bazel:files.bzl", "IGNORED", "package_files")
load("//tools/bazel/bun:bun.bzl", "bun_test_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The committed interop vectors both sides of each contract test against.
filegroup(
    name = "test_vectors",
    srcs = glob(["test-vectors/**"]),
)

# The display wire constants the terminal's profile training builds its frames from.
exports_files([
    "src/binary.ts",
    "src/display-stream.ts",
])

npm_link_all_packages(name = "node_modules")

# The workspace package as pnpm links it into its dependents: every file it ships beside its
# `package.json`, with its own dependencies.
js_library(
    name = "pkg",
    srcs = glob(
        ["**"],
        exclude = IGNORED + ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
    deps = [":node_modules"],
)

bun_test_files(
    # Both ends of the daemon's IPC, which the conformance test holds to one wire.
    files = {"src/ipc-wire-conformance.test.ts": {"data": [
        "//apps/daemon:src/services/dataplane-client.ts.module",
        "//apps/daemon/dataplane:src/ipc/commands.rs.module",
        "//apps/daemon/dataplane:src/ipc/events.rs.module",
        "//apps/daemon/dataplane:src/session/rebind_flow.rs.module",
        "//packages/merkur-traversal:src/portmap/mod.rs.module",
    ]}},
    tests = glob(
        ["**/*.test.ts"],
        exclude = IGNORED,
    ),
)
