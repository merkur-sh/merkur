load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Clippy holds the crate to the minimum Rust release its manifest declares, as Cargo tells it.
_RUST_VERSION = {"CARGO_PKG_RUST_VERSION": "1.85.0"}

# Every workspace consumer takes the crate without default features. The vendored crate keeps
# upstream's lint levels, so it takes no lint configuration.
rust_library(
    name = "alacritty_terminal",
    rustc_env = _RUST_VERSION,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.26.0",
    deps = ["//packages/vte-patch:vte"] + all_crate_deps(normal = True),
)

# Its own tests build it as Cargo tests a package: with its default `serde` feature.
rust_library(
    name = "alacritty_terminal_serde",
    rustc_env = _RUST_VERSION,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "default",
        "serde",
    ],
    crate_name = "alacritty_terminal",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.26.0",
    deps = ["//packages/vte-patch:vte_serde"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    rustc_env = _RUST_VERSION,
    crate = ":alacritty_terminal_serde",
    crate_features = [
        "default",
        "serde",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "ref",
    rustc_env = _RUST_VERSION,
    srcs = ["tests/ref.rs"],
    data = glob(["tests/ref/**"]),
    deps = [":alacritty_terminal_serde"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "anchor_allocations",
    rustc_env = _RUST_VERSION,
    srcs = ["tests/anchor_allocations.rs"],
    deps = [":alacritty_terminal_serde"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_doc_test(
    name = "doc",
    crate = ":alacritty_terminal_serde",
    crate_features = [
        "default",
        "serde",
    ],
)
