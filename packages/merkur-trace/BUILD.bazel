load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The crate's sources, which the browser build in `//tools/bazel/wasm` and the simulator's
# crate hub (`//tools/bazel/sim`) compile too.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "merkur_trace",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

# The capture-file test compares against the fixture `tools/profile`'s reader also reads.
rust_test(
    name = "unit",
    compile_data = ["testdata/capture.mtrace"],
    crate = ":merkur_trace",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
