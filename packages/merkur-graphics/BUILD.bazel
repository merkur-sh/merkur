load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The crate's sources, which the browser build in `//tools/bazel/wasm` compiles too.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "merkur_graphics",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_graphics",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = ["//packages/vte-patch:vte"] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "allocation",
    srcs = ["tests/allocation.rs"],
    lint_config = ":lints",
    deps = [
        ":merkur_graphics",
        "//packages/vte-patch:vte",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "integration",
    srcs = glob(["tests/integration/*.rs"]),
    compile_data = glob(["tests/fixtures/**"]),
    crate_root = "tests/integration/main.rs",
    lint_config = ":lints",
    deps = [
        ":merkur_graphics",
        "//packages/vte-patch:vte",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_graphics",
)
