load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//tools/bazel/rust:defs.bzl", "rust_release_test")
load("//tools/bazel:files.bzl", "package_files")
load("//tools/bazel/wasm:defs.bzl", "wasm_package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The crate's sources, which the browser build in `//tools/bazel/wasm` compiles too.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

# The browser terminal as a native library: what the dataplane, the TUI and the native client
# drive, and what its own tests run.
rust_library(
    name = "term_wasm",
    srcs = [":srcs"],
    aliases = aliases(),
    compile_data = ["//apps/web:fonts"],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [
        "//packages/alacritty-terminal-patch:alacritty_terminal",
        "//packages/fontdue-patch:fontdue",
        "//packages/merkur-client:merkur_client",
        "//packages/merkur-codec:merkur_codec",
        "//packages/merkur-graphics:merkur_graphics",
        "//packages/merkur-wire:merkur_wire",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":term_wasm",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

# The same suite in the release profile the shipped terminal is built in.
rust_release_test(
    name = "release_unit",
    crate = ":term_wasm",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":term_wasm",
)

# The browser module where the TypeScript that loads it imports it from, `pkg/`.
wasm_package_files(
    name = "pkg_files",
    package = "//tools/bazel/wasm/term-wasm:imported_pkg",
)
