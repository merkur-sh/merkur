load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Clippy holds the crate to the minimum Rust release its manifest declares, as Cargo tells it.
_RUST_VERSION = {"CARGO_PKG_RUST_VERSION": "1.62.1"}

# The workspace builds vte with `std` and `ansi`, which alacritty_terminal asks for; the
# vendored crate keeps upstream's lint levels, so it takes no lint configuration.
rust_library(
    name = "vte",
    rustc_env = _RUST_VERSION,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "ansi",
        "default",
        "std",
    ],
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.15.0",
    deps = all_crate_deps(normal = True),
)

# alacritty_terminal's own tests build it with its default `serde` feature, which reaches vte.
rust_library(
    name = "vte_serde",
    rustc_env = _RUST_VERSION,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "ansi",
        "default",
        "serde",
        "std",
    ],
    crate_name = "vte",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.15.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    rustc_env = _RUST_VERSION,
    compile_data = ["tests/demo.vte"],
    crate = ":vte",
    crate_features = [
        "ansi",
        "default",
        "std",
    ],
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":vte",
    crate_features = [
        "ansi",
        "default",
        "std",
    ],
)

rust_binary(
    name = "parselog",
    rustc_env = _RUST_VERSION,
    srcs = ["examples/parselog.rs"],
    edition = "2021",
    deps = [":vte"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
