load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "merkur_traversal",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/portmap/fixtures/**"]),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = ["//packages/merkur-stun-protocol:merkur_stun_protocol"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_traversal",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)
