load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# The crate's sources, which the browser build in `//tools/bazel/wasm` compiles too.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

# The crate's own vectors, which its tests embed.
filegroup(
    name = "test_vectors",
    srcs = glob(["test-vectors/**"]),
)

# The `testing` feature: vector helpers for other crates' tests, which build with it through
# `rust_test_e2e_testing` (`//tools/bazel/rust:defs.bzl`). No shipped binary sees it.
bool_flag(
    name = "testing",
    build_setting_default = False,
)

config_setting(
    name = "testing_enabled",
    flag_values = {":testing": "true"},
)

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "merkur_e2e",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "default",
        "std",
    ] + select({
        ":testing_enabled": ["testing"],
        "//conditions:default": [],
    }),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    compile_data = [
        ":test_vectors",
        "//packages/shared:test_vectors",
    ],
    crate = ":merkur_e2e",
    crate_features = [
        "default",
        "std",
    ],
    data = [
        ":test_vectors",
        "//packages/shared:test_vectors",
    ],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "content_allocations",
    srcs = ["tests/content_allocations.rs"],
    lint_config = ":lints",
    deps = [":merkur_e2e"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_e2e",
    crate_features = [
        "default",
        "std",
    ],
    deps = all_crate_deps(normal_dev = True),
)

rust_binary(
    name = "bench_e2e",
    srcs = ["benches/e2e.rs"],
    lint_config = ":lints",
    deps = [":merkur_e2e"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
