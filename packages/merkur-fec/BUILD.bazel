load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# The crate's sources, which the browser build in `//tools/bazel/wasm` compiles too.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "merkur_fec",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_fec",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

[rust_test(
    name = test,
    srcs = ["tests/%s.rs" % test],
    lint_config = ":lints",
    deps = [":merkur_fec"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
) for test in [
    "kernel_profile",
    "roundtrip",
]]

rust_doc_test(
    name = "doc",
    crate = ":merkur_fec",
)
