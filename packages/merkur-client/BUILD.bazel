load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library")
load("//tools/bazel/rust:defs.bzl", "rust_e2e_testing_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

_DEPS = [
    "//packages/merkur-authorization:merkur_authorization",
    "//packages/merkur-codec:merkur_codec",
    "//packages/merkur-e2e:merkur_e2e",
    "//packages/merkur-edge-protocol:merkur_edge_protocol",
    "//packages/merkur-fec:merkur_fec",
    "//packages/merkur-graphics:merkur_graphics",
    "//packages/merkur-wire:merkur_wire",
]

rust_library(
    name = "merkur_client",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "default",
        "std",
    ],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _DEPS + all_crate_deps(normal = True),
)

# The tests of what follows key exhaustion use merkur-e2e's `testing` hooks.
rust_e2e_testing_test(
    name = "unit",
    crate = ":merkur_client",
    crate_features = [
        "default",
        "std",
    ],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "doc",
    crate = ":merkur_client",
    crate_features = [
        "default",
        "std",
    ],
)

rust_binary(
    name = "browser_session_oracle",
    # It includes the crate's test support module by path.
    srcs = ["examples/browser_session_oracle.rs"] + glob(["src/**/*.rs"]),
    crate_root = "examples/browser_session_oracle.rs",
    lint_config = ":lints",
    deps = [":merkur_client"] + _DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
