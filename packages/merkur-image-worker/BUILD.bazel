load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The crate's sources and root, which the simulator's crate hub compiles too
# (`//tools/bazel/sim`).
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

exports_files(["src/lib.rs"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

_DEPS = ["//packages/merkur-graphics:merkur_graphics"]

rust_library(
    name = "merkur_image_worker",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _DEPS + all_crate_deps(normal = True),
)

rust_binary(
    name = "merkur-image-worker",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    aliases = aliases(),
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":merkur_image_worker"] + _DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "unit",
    crate = ":merkur_image_worker",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = ["//packages/graphics-codec-probe:graphics_codec_probe"] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "bin_unit",
    crate = ":merkur-image-worker",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = ["//packages/graphics-codec-probe:graphics_codec_probe"] + all_crate_deps(normal_dev = True),
)

# Each suite drives the built helper as Cargo hands it over: by `CARGO_BIN_EXE_merkur-image-worker`.
# The helper confines itself with the operating system's sandbox, which macOS refuses to nest
# inside Bazel's, so these suites run unsandboxed.
[rust_test(
    name = test,
    # `isolation` includes the helper's sandbox module by path.
    srcs = ["tests/%s.rs" % test] + glob(["src/**/*.rs"]),
    crate_root = "tests/%s.rs" % test,
    data = [":merkur-image-worker"],
    lint_config = ":lints",
    rustc_env = {"CARGO_BIN_EXE_merkur-image-worker": "$(rootpath :merkur-image-worker)"},
    tags = ["no-sandbox"],
    deps = [
        ":merkur_image_worker",
        "//packages/graphics-codec-probe:graphics_codec_probe",
    ] + _DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
) for test in [
    "composition",
    "descriptor",
    "encoding_allocations",
    "hostile_output",
    "isolation",
]]

rust_doc_test(
    name = "doc",
    crate = ":merkur_image_worker",
)

rust_binary(
    name = "tile-codec-bench",
    srcs = ["examples/tile-codec-bench.rs"],
    lint_config = ":lints",
    deps = [
        ":merkur_image_worker",
        "//packages/graphics-codec-probe:graphics_codec_probe",
    ] + _DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
