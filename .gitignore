# OS/editor noise
.DS_Store
*.swp
*.swo

# Dependency directories
node_modules/
**/node_modules/

# Build outputs
/bazel-*
/.bazelrc.local
dist/
build/
# These directories contain declared Cargo resolution facts, not build outputs.
!/tools/bazel/rust/contexts/*/build/
coverage/
**/*.tsbuildinfo
packages/*/dist/
apps/web/src/term-wasm/pkg/
apps/web/src/e2e-wasm/pkg/
apps/web/src/graphics-wasm/pkg/
packages/term-wasm/pkg/
packages/e2e-wasm/pkg/
packages/graphics-wasm/pkg/
packages/graphics-codec-probe/pkg/
packages/term-wasm/target/
packages/alacritty-terminal-patch/target/
packages/quinn-patch/Cargo.lock
packages/quinn-proto-patch/Cargo.lock
apps/daemon/dataplane/target/
target/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local tooling caches
.tools/
.codegraph/daemon.pid
.claude/worktrees/

# Runtime data / local env
data/
.e2e-home*/
.dev/*.pem
.env
.env.*
!.env.example
!**/.env.example

# Test artifacts
playwright-report/
test-results/

# Signed release manifests written by scripts/sign-release-manifest.ts. The
# bytes are canonical and ML-DSA-87 signed, so they are never edited, formatted,
# or committed; releases publish them from dist/.
merkur-release.json
merkur-release.sig

# Daemon release tarballs built by Dockerfile.daemon-release into its `artifacts`
# stage. Each is tens of megabytes of compressed binaries; they are published
# from the build, never from the tree.
merkur-daemon-*.tar.gz

# Local cloud-tester daemon home (contains api_key/daemon_auth_key — never commit)
.cloud-tester/

# Offline-signed server/web bundle consumed by Docker packaging.
/deployment/

# Per-replica Fly configs rendered by scripts/edge-fly-config.ts from
# apps/edge/replicas.json. Re-rendered on every deploy; never committed.
apps/edge/fly/

# Python release orchestration bytecode
__pycache__/

# Agent transcripts exported into the checkout (Codex session dumps, Claude `/export`).
/codex-session-*.md
/claude-session-*.md
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt
