{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.claude",
      "!**/.agents",
      "!**/apps/server/data",
      "!**/packages/alacritty-terminal-patch/.cargo_vcs_info.json",
      "!**/packages/alacritty-terminal-patch/tests/ref",
      "!**/packages/term-wasm/target",
      "!**/packages/term-wasm/vendor/alacritty_terminal",
      "!**/packages/shared/test-vectors",
      "!**/packages/merkur-e2e/test-vectors/wycheproof/*.json",
      "!**/tools/codeql/*/test",
      "!**/merkur-release.json",
      "!**/fallow-baselines/dead-code.json",
      "!**/fallow-baselines/dupes.json",
      "!**/merkur-release.sig"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "noExcessiveNestedTestSuites": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/**",
        "packages/**",
        "!packages/browser-storage/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "Declare the key with localValue from @merkur/browser-storage, which parses every read and counts every failure.",
                  "sessionStorage": "Declare the key with sessionValue from @merkur/browser-storage, which parses every read and counts every failure.",
                  "indexedDB": "Declare the database with defineDatabase from @merkur/browser-storage, which parses every read and counts every failure."
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
