{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.claude",
      "!**/.agents",
      "!**/apps/server/data",
      "!**/packages/alacritty-terminal-patch/.cargo_vcs_info.json",
      "!**/packages/alacritty-terminal-patch/tests/ref",
      "!**/packages/term-wasm/target",
      "!**/packages/term-wasm/vendor/alacritty_terminal",
      "!**/packages/shared/test-vectors",
      "!**/packages/merkur-e2e/test-vectors/wycheproof/*.json",
      "!**/tools/bazel/bun/import-inventory.json",
      "!**/tools/bazel/rust/metadata.json",
      "!**/tools/bazel/rust/source_inputs.json",
      "!**/tools/bazel/rust/contexts/**/metadata.json",
      "!**/tools/bazel/rust/units/graph.json",
      "!**/tools/bazel/rust/units/provenance/*.json",
      "!**/tools/bazel/rust/diagnostics/bolero/merkur-stun-protocol.json",
      "!**/tools/bazel/rust/diagnostics/bolero/merkur-wire.json",
      "!**/tools/bazel/rust/diagnostics/bolero/term-wasm.json",
      "!**/tools/bazel/rust/diagnostics/oracles/browser-session-oracle.json",
      "!**/tools/bazel/rust/policy_snapshots/production.json",
      "!**/tools/bazel/rust/policy_snapshots/bolero.json",
      "!**/tools/bazel/rust/policy_snapshots/ownership.json",
      "!**/tools/bazel/rust/policy_snapshots/aya.json",
      "!**/merkur-release.json",
      "!**/merkur-release.sig"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "noExcessiveNestedTestSuites": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
