# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS bun
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip \
  && case "$(dpkg --print-architecture)" in \
    amd64) build=x64-baseline; digest=c678040f14fe0440eb839d37cbd0ce4c051a32da72806ac97de6a6aab6bf728f ;; \
    arm64) build=aarch64; digest=54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7 ;; \
    *) echo "unsupported Bun architecture" >&2; exit 1 ;; \
  esac \
  && curl --fail --silent --show-error --location "https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-linux-$build.zip" -o /tmp/bun.zip \
  && printf '%s  /tmp/bun.zip\n' "$digest" | sha256sum --check \
  && unzip -p /tmp/bun.zip "bun-linux-$build/bun" > /usr/local/bin/bun \
  && chmod 0755 /usr/local/bin/bun \
  && ln -s bun /usr/local/bin/bunx \
  && ln -s bun /usr/local/bin/node \
  && test "$(bun --version)" = 1.4.2 \
  && rm -rf /tmp/bun.zip /var/lib/apt/lists/*
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 BUN_INSTALL_BIN=/usr/local/bin

# Debian 12 is Merkur's Linux ABI floor. Building on a newer distribution
# can silently introduce glibc symbols that are unavailable to users.
FROM public.ecr.aws/docker/library/rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS builder

ARG MERKUR_PUBLIC_ORIGIN
ARG MERKUR_OPAQUE_SERVER_PUBLIC_KEY
ARG MERKUR_VERSION
ARG MERKUR_RELEASE_SEQUENCE
ARG MERKUR_RELEASE_MLDSA87_PUBLIC_KEY
ARG TARGETARCH

WORKDIR /app

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    lld \
    llvm \
    pkg-config \
    libssl-dev \
  && rustup target add wasm32-unknown-unknown \
  && cargo install wasm-pack --version 0.15.0 --locked \
  && rm -rf /var/lib/apt/lists/*

# The CLI embeds the e2e WebAssembly module (ML-DSA-87 for release and link
# verification), which `scripts/build-daemon-dist.ts` builds with wasm-pack and
# the wasm-bindgen CLI pinned in Cargo.lock. Installed against just those two
# files so the layer survives source changes; see the main Dockerfile.
COPY Cargo.lock rust-toolchain.toml ./
RUN version="$(awk '/^name = "wasm-bindgen"$/ { getline; gsub(/version = "|"/, ""); print; exit }' Cargo.lock)" \
  && test -n "$version" \
  && cargo install wasm-bindgen-cli --version "$version" --locked --root .tools/wasm-bindgen

COPY package.json bun.lock ./
COPY apps/daemon/package.json apps/daemon/package.json
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/daemon-control-protocol/package.json packages/daemon-control-protocol/package.json
COPY packages/keyboard/package.json packages/keyboard/package.json
COPY packages/logger/package.json packages/logger/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/quicksilver/package.json packages/quicksilver/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/user-agent/package.json packages/user-agent/package.json

RUN --mount=type=cache,target=/root/.bun/install/cache,sharing=locked \
  bun install --frozen-lockfile

COPY Cargo.toml Cargo.lock rust-toolchain.toml tsconfig.base.json LICENSE ./
COPY .cargo/ .cargo/
COPY apps/ apps/
COPY packages/ packages/
COPY scripts/ scripts/
# The profile-guided training build compiles the dataplane tests, which read it.
COPY tests/fixtures/kitty/reference.json tests/fixtures/kitty/reference.json

RUN --mount=type=cache,id=merkur-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
  --mount=type=cache,id=merkur-cargo-git,target=/usr/local/cargo/git,sharing=locked \
  test -n "${MERKUR_RELEASE_SEQUENCE}" \
  && test -n "${MERKUR_RELEASE_MLDSA87_PUBLIC_KEY}" \
  && MERKUR_PUBLIC_ORIGIN="${MERKUR_PUBLIC_ORIGIN}" \
    MERKUR_OPAQUE_SERVER_PUBLIC_KEY="${MERKUR_OPAQUE_SERVER_PUBLIC_KEY}" \
    MERKUR_RELEASE_MLDSA87_PUBLIC_KEY="${MERKUR_RELEASE_MLDSA87_PUBLIC_KEY}" \
    bun run scripts/build-daemon-dist.ts \
      --version "${MERKUR_VERSION}" \
      --sequence "${MERKUR_RELEASE_SEQUENCE}" \
  && test "$(apps/daemon/dist/merkur version)" = "${MERKUR_VERSION}" \
  && case "${TARGETARCH}" in \
    amd64) platform=linux-x64 ;; \
    arm64) platform=linux-arm64 ;; \
    *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
  esac \
  && mkdir -p /release \
  && COPYFILE_DISABLE=1 tar --format=ustar --no-xattrs \
    -czf "/release/merkur-daemon-${platform}.tar.gz" \
    -C apps/daemon/dist merkur merkur-dataplane merkur-image-worker merkur-tui \
  && bun build scripts/ci-release-verify.ts --compile --outfile "/release/verify-${platform}"

FROM scratch AS artifacts
COPY --from=builder /release/ /
