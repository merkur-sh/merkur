#!/bin/sh
set -eu
bun run scripts/secret-scanning.ts staged
# core.hooksPath is shared by every worktree; a branch that predates a gate has no script.
if [ -f scripts/check-ratchet.ts ]; then
  bun run scripts/check-ratchet.ts --staged
fi
# The anti-slop baseline is what a commit is held to: until HEAD or the index carries it, the
# gate is not adopted on this branch and a commit from the shared checkout must not wait on it.
if [ -f scripts/check-slop.ts ] &&
  { git cat-file -e HEAD:lint-baselines/anti-slop.json 2>/dev/null ||
    git cat-file -e :lint-baselines/anti-slop.json 2>/dev/null; }; then
  exec bun run scripts/check-slop.ts --staged
fi
