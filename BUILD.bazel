load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

exports_files([
    ".bun-version",
    "Cargo.lock",
    "Cargo.toml",
    "clippy.toml",
    "package.json",
    "rust-toolchain.toml",
])

# What Bun reads at the repository root before it runs any TypeScript: the compiler options and
# the path aliases every package resolves through.
filegroup(
    name = "typescript_config",
    srcs = [
        "tsconfig.base.json",
        "tsconfig.json",
    ],
    visibility = ["//visibility:public"],
)
