load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//tools/bazel/rust:defs.bzl", "merkur_rust_negative_test", "merkur_rust_test", "profile_flags")
load("//tools/bazel/rust:ownership.bzl", "ownership_sources")
load("//tools/bazel/rust:kani.bzl", "kani_proof_test")

# Exact Cargo.lock direct edges; external labels are acquired only for compile targets.
_BUILD_DEPS = [
    "@crates_ownership//quote-1.0.45",
    "@crates_ownership//syn-2.0.119",
]

_DEV_DEPS = [
    "@crates_ownership//loom-0.7.2",
]

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml", "Cargo.lock"])

filegroup(name = "verification_inputs", srcs = glob(["**"], exclude = ["node_modules/**", "target/**", "dist/**", "pkg/**", "test-results/**", ".*", "**/.*", ".*/**", "**/.*/**", "__pycache__/**", "**/__pycache__/**", "*.pyc", "**/*.pyc", ".env", ".env.*", "**/.env", "**/.env.*", ".bazelrc.local", "**/.bazelrc.local", ".DS_Store", "**/.DS_Store"]))

rust_binary(
    name = "extractor",
    crate_root = "//tools/bazel/rust:extract_ownership.rs",
    srcs = ["//tools/bazel/rust:extract_ownership.rs"],
    edition = "2024",
    deps = _BUILD_DEPS,
)

ownership_sources(
    name = "production_sources",
    extractor = ":extractor",
    e2e = "//packages/merkur-e2e:src/lib.rs",
    client = "//packages/merkur-client:src/session.rs",
    edge = "//apps/edge:src/splice.rs",
)

rust_library(
    name = "ownership",
    crate_name = "merkur_ownership_proofs",
    crate_root = "src/lib.rs",
    srcs = ["src/lib.rs"],
    compile_data = [":production_sources"],
    edition = "2024",
    rustc_env = {"OUT_DIR": "$(execpath :production_sources)"},
    rustc_flags = profile_flags() + ["--check-cfg=cfg(kani,test)", "-Dwarnings"],
)

filegroup(name = "package_data", srcs = glob(["src/**/*.rs", "tests/**/*.rs", "*.toml"]))

merkur_rust_test(
    name = "custody",
    crate = ":ownership",
    deps = _DEV_DEPS,
    data = [":package_data"],
)

# This is the unchanged five-model test binary; no preemption/iteration cap.
merkur_rust_test(
    name = "loom",
    crate_name = "edge_routing",
    crate_root = "tests/edge_routing.rs",
    srcs = ["tests/edge_routing.rs"],
    compile_data = [":production_sources"],
    edition = "2024",
    deps = _DEV_DEPS,
    rustc_env = {"OUT_DIR": "$(execpath :production_sources)"},
    rustc_flags = profile_flags() + ["--check-cfg=cfg(kani,test)", "-Dwarnings"],
    data = [":package_data"],
)

kani_proof_test(
    name = "kani",
    src = "src/lib.rs",
    production_sources = ":production_sources",
)

ownership_sources(
    name = "production_sources_custody",
    extractor = ":extractor",
    e2e = "//packages/merkur-e2e:src/lib.rs",
    client = "//packages/merkur-client:src/session.rs",
    edge = "//apps/edge:src/splice.rs",
    control = "custody",
)

kani_proof_test(
    name = "negative_custody",
    src = "src/lib.rs",
    production_sources = ":production_sources_custody",
    negative = True,
)

[
    ownership_sources(
        name = "production_sources_" + control,
        extractor = ":extractor",
        e2e = "//packages/merkur-e2e:src/lib.rs",
        client = "//packages/merkur-client:src/session.rs",
        edge = "//apps/edge:src/splice.rs",
        control = control,
    )
    for control in ["route_guard", "retirement", "slot_drop", "stale_detach"]
]

[
    merkur_rust_negative_test(
        name = "negative_" + control,
        crate_name = "edge_routing_" + control,
        crate_root = "tests/edge_routing.rs",
        srcs = ["tests/edge_routing.rs"],
        compile_data = [":production_sources_" + control],
        edition = "2024",
        deps = _DEV_DEPS,
        rustc_env = {"OUT_DIR": "$(execpath :production_sources_" + control + ")"},
        rustc_flags = profile_flags() + ["--check-cfg=cfg(kani,test)", "-Dwarnings"],
        data = [":package_data"],
        filter = filter,
        signal = signal,
    )
    for control, filter, signal in [
        ("route_guard", "source_replacement_never_admits_the_retired_writer", "admitted retired source"),
        ("retirement", "retiring_the_pair_revokes_retained_route_handles", "assertion failed: !route.route(frame(&source))"),
        ("slot_drop", "slot_drop_revokes_old_handles_before_label_reuse", "assertion failed: !route.route(frame(&source))"),
        ("stale_detach", "stale_detach_cannot_remove_a_successor_attachment", "assertion failed: route.route(frame(&source))"),
    ]
]
