engine biome(1.0)
language js(typescript, jsx)

// Every runtime `typeof`, except the existence probe: `typeof name` compared, with any of the four
// equality operators and on either side, to the string literal 'undefined'. Parentheses around
// either side do not change that; they are followed two deep.

pattern through_parens($inner) {
  or {
    $inner,
    JsParenthesizedExpression(expression=$inner),
    JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=$inner))
  }
}

pattern undefined_string() {
  JsStringLiteralExpression() as $literal where {
    $literal <: or {
      "'undefined'",
      r"\"undefined\""
    }
  }
}

pattern existence_probe($probe) {
  or {
    `$left === $right`,
    `$left !== $right`,
    `$left == $right`,
    `$left != $right`
  } where {
    or {
      and {
        $left <: through_parens(inner=$probe),
        $right <: through_parens(inner=undefined_string())
      },
      and {
        $right <: through_parens(inner=$probe),
        $left <: through_parens(inner=undefined_string())
      }
    }
  }
}

`typeof $operand` as $probe where {
  ! $probe <: within existence_probe($probe) ,
  register_diagnostic(span=$probe, message="[no-runtime-typeof] `typeof` tells a representation apart without settling what the value means. Decode the input where it enters, then branch on the decoded value.", severity="error")
}
