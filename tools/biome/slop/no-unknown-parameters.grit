engine biome(1.0)
language js(typescript, jsx)

// A parameter annotated `unknown`, or with a union that has `unknown` in it (through parentheses
// and nested unions), on any function, method, signature or function type. Two parameters are
// left alone: one named `cause`, and the subject of the function's own type predicate
// (`value is T`, `asserts value`).
//
// GritQL patterns cannot recurse, so `unknown` is looked for three levels of union/parenthesis
// deep.

pattern unknown_0() { TsUnknownType() }

pattern unknown_1() {
  or {
    unknown_0(),
    TsParenthesizedType(ty=unknown_0()),
    TsUnionType(types=some unknown_0())
  }
}

pattern unknown_2() {
  or {
    unknown_1(),
    TsParenthesizedType(ty=unknown_1()),
    TsUnionType(types=some unknown_1())
  }
}

pattern unknown_3() {
  or {
    unknown_2(),
    TsParenthesizedType(ty=unknown_2()),
    TsUnionType(types=some unknown_2())
  }
}

pattern predicate_on($name) {
  or {
    TsPredicateReturnType(parameter_name=$name),
    TsAssertsReturnType(parameter_name=$name)
  }
}

// Everything that owns a parameter list: the nearest one above a parameter is its function.
pattern parameter_owner() {
  or {
    JsFunctionDeclaration(),
    JsFunctionExpression(),
    JsFunctionExportDefaultDeclaration(),
    JsArrowFunctionExpression(),
    JsMethodClassMember(),
    JsMethodObjectMember(),
    JsConstructorClassMember(),
    JsSetterClassMember(),
    JsSetterObjectMember(),
    TsMethodSignatureClassMember(),
    TsConstructorSignatureClassMember(),
    TsSetterSignatureClassMember(),
    TsMethodSignatureTypeMember(),
    TsCallSignatureTypeMember(),
    TsConstructSignatureTypeMember(),
    TsSetterSignatureTypeMember(),
    TsDeclareFunctionDeclaration(),
    TsDeclareFunctionExportDefaultDeclaration(),
    TsFunctionType(),
    TsConstructorType()
  }
}

pattern predicate_owner($name) {
  or {
    JsFunctionDeclaration(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    JsFunctionExpression(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    JsFunctionExportDefaultDeclaration(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    JsArrowFunctionExpression(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    JsMethodClassMember(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    JsMethodObjectMember(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    TsMethodSignatureClassMember(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    TsMethodSignatureTypeMember(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    TsCallSignatureTypeMember(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    TsDeclareFunctionDeclaration(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    TsDeclareFunctionExportDefaultDeclaration(return_type_annotation=TsReturnTypeAnnotation(ty=predicate_on($name))),
    TsFunctionType(return_type=predicate_on($name))
  }
}

or {
  JsFormalParameter(binding=$binding, type_annotation=TsTypeAnnotation(ty=$type)),
  JsRestParameter(binding=$binding, type_annotation=TsTypeAnnotation(ty=$type)),
  TsThisParameter(type_annotation=TsTypeAnnotation(ty=$type)) where { $binding = `this` }
} as $parameter where {
  // A substring test first: this runs on every typed parameter in the tree.
  $type <: includes "unknown",
  $type <: unknown_3(),
  ! $binding <: r"cause",
  $parameter <: within parameter_owner() as $owner ,
  ! $owner <: predicate_owner(name=$binding),
  register_diagnostic(span=$type, message=join(list=[
    "[no-unknown-parameters] Parameter `",

    $binding,

    "` takes input nobody has decoded. Give it a named domain type, and run the schema or parser where the input enters, before this call.",
  ], separator=""), severity="error")
}
