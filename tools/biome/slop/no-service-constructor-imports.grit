engine biome(1.0)
language js(typescript, jsx)

// A named import whose imported name starts `make` plus a capital, from a relative module (`./`
// or `../`), in a file that is not a `.test.` or `.spec.` file.

pattern relative_source() { JsModuleSource() as $source where { $source <: r"['\"]\.\.?/.*" } }

or {
  JsNamedImportSpecifier(name=$imported),
  JsShorthandNamedImportSpecifier(local_name=$imported)
} as $specifier where {
  $imported <: r"['\"]?make[A-Z].*",
  ! $filename <: r".*\.(?:test|spec)\.[cm]?[jt]sx?",
  $specifier <: within JsImport() as $import ,
  $import <: contains relative_source(),
  register_diagnostic(span=$specifier, message=join(list=[
    "[no-service-constructor-imports] `",

    $imported,

    "` builds a service with its dependencies outside the module that owns it. Import the owning Layer and yield the service from context, so its requirements reach the composition root.",
  ], separator=""), severity="error")
}
