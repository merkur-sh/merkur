engine biome(1.0)
language js(typescript, jsx)

// An object literal property `_tag` (`_tag:`, `'_tag':` or `['_tag']:`) whose value is a string
// literal, unless the object is itself an argument of `Match.when` or `Match.not`, where it is a
// pattern and not a value.

pattern tag_key() {
  or {
    JsLiteralMemberName() as $key where { $key <: r"['\"]?_tag['\"]?" },
    JsComputedMemberName(expression=JsStringLiteralExpression() as $key) where {
      $key <: r"['\"]_tag['\"]"
    }
  }
}

pattern string_value() {
  or {
    JsStringLiteralExpression(),
    JsParenthesizedExpression(expression=JsStringLiteralExpression()),
    JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=JsStringLiteralExpression()))
  }
}

JsPropertyObjectMember(name=$key, value=$value) as $property where {
  // A substring test first: this runs on every object property in the tree.
  $key <: includes "_tag",
  $key <: tag_key(),
  $value <: string_value(),
  $property <: within JsObjectExpression() as $object ,
  ! $object <: within JsCallExpression(callee=JsStaticMemberExpression(object=`Match`, member=$method), arguments=JsCallArguments(args=$arguments)) where {
    $method <: r"(?:when|not)",
    $arguments <: some $object
  } ,
  register_diagnostic(span=$property, message="[no-manual-tagged-construction] A literal `_tag` builds a tagged value around its constructor. Use the schema's `.make`, the tagged class or error constructor, or the `Data.taggedEnum` variant.", severity="error")
}
