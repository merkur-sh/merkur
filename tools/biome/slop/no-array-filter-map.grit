engine biome(1.0)
language js(typescript, jsx)

// `.filter(…).map(…)` or `.map(…).filter(…)` directly on a value known to be an array: an array
// literal, the result of an array-returning method on one, or a name declared with an array type
// or as a `const` initialised with one. Iterator pipelines (`.values().filter(…).map(…)`) and
// receivers of unknown type are left alone.
//
// Scope is rebuilt from syntax: a name belongs to the nearest enclosing function that has it as a
// parameter, or the nearest enclosing statement list (block, function body, module, `case`) that
// declares it with `const`/`let`/`var`, or the nearest `for`/`catch` that binds it. This reads
// only each ancestor's own parameters and statements, never its whole subtree; a walk of the
// subtree per reference took this rule alone to 20 s.
//
// What that does not see:
//   - a nearer `function`, `class`, `enum` or import of the same name is not taken as a shadow;
//   - an assignment to an array-typed parameter or `let` is looked for only where one can exist
//     (not for `const`), inside the scope found;
//   - two `const` aliases are followed, array-returning method chains two deep between them, and
//     type wrappers (parentheses, `as`, `satisfies`, `!`) two deep;
//   - a parenthesised or asserted callee (`(xs.filter(f).map)(g)`) is not looked through.

pattern wrapped($inner) {
  or {
    JsParenthesizedExpression(expression=$inner),
    TsAsExpression(expression=$inner),
    TsSatisfiesExpression(expression=$inner),
    TsNonNullAssertionExpression(expression=$inner),
    TsTypeAssertionExpression(expression=$inner)
  }
}

pattern bare($inner) {
  or {
    $inner,
    wrapped($inner),
    wrapped(inner=wrapped($inner))
  }
}

// `object.method` or `object['method']`, for the methods this rule names.
pattern member($object, $method) {
  or {
    JsStaticMemberExpression(object=$object, member=$method),
    JsComputedMemberExpression(object=$object, member=JsStringLiteralExpression() as $quoted) where {
      $quoted <: or {
        "'map'" where { $method = "map" },
        r"\"map\"" where { $method = "map" },
        "'filter'" where { $method = "filter" },
        r"\"filter\"" where { $method = "filter" },
        "'flatMap'" where { $method = "flatMap" },
        r"\"flatMap\"" where { $method = "flatMap" },
        "'slice'" where { $method = "slice" },
        r"\"slice\"" where { $method = "slice" },
        "'concat'" where { $method = "concat" },
        r"\"concat\"" where { $method = "concat" }
      }
    }
  }
}

pattern array_type() {
  or {
    TsArrayType(),
    TsTupleType(),
    TsParenthesizedType(ty=or {
      TsArrayType(),
      TsTupleType()
    }),
    TsTypeOperatorType() as $operator where { $operator <: r"(?s)readonly\s.*[\]\)]" },
    TsReferenceType(name=or {
      "Array",
      "ReadonlyArray"
    })
  }
}

// A `const`/`let`/`var` statement, exported or not. Every condition on the declaration is passed
// in as part of the pattern: a list is searched for the first element that matches the pattern,
// and a condition tested afterwards would be tested on that element only.
pattern declaring($declaration) {
  or {
    JsVariableStatement(declaration=$declaration),
    JsExport(export_clause=JsVariableDeclarationClause(declaration=$declaration))
  }
}

// A node whose own statements include `$statement`.
pattern statements_with($statement) {
  or {
    JsFunctionBody(statements=some $statement),
    JsBlockStatement(statements=some $statement),
    JsModule(items=some $statement),
    JsScript(statements=some $statement),
    TsModuleBlock(items=some $statement),
    JsCaseClause(consequent=some $statement),
    JsDefaultClause(consequent=some $statement),
    JsStaticInitializationBlockClassMember(statements=some $statement)
  }
}

// A function whose parameters are `$parameters`.
pattern function_with($parameters) {
  or {
    JsArrowFunctionExpression(parameters=$parameters),
    JsFunctionDeclaration(parameters=$parameters),
    JsFunctionExpression(parameters=$parameters),
    JsFunctionExportDefaultDeclaration(parameters=$parameters),
    JsMethodClassMember(parameters=$parameters),
    JsMethodObjectMember(parameters=$parameters),
    JsConstructorClassMember(parameters=$parameters),
    JsSetterClassMember(parameter=$parameters),
    JsSetterObjectMember(parameter=$parameters)
  }
}

pattern binds($name) { contains JsIdentifierBinding() as $bound where { $bound <: $name } }

// The scope `$name` belongs to at a reference: nearest of the forms above that binds it.
pattern scope_of($name) {
  or {
    function_with(parameters=binds($name)),
    statements_with(statement=declaring(declaration=JsVariableDeclaration(declarators=some JsVariableDeclarator(id=binds($name))))),
    JsForOfStatement(initializer=binds($name)),
    JsForInStatement(initializer=binds($name)),
    JsForStatement(initializer=binds($name)),
    JsCatchClause(declaration=binds($name))
  }
}

pattern array_parameter($name) {
  or {
    JsFormalParameter(binding=$name, type_annotation=TsTypeAnnotation(ty=array_type())),
    JsRestParameter(binding=$name, type_annotation=TsTypeAnnotation(ty=array_type())),
    TsPropertyParameter(formal_parameter=JsFormalParameter(binding=$name, type_annotation=TsTypeAnnotation(ty=array_type())))
  }
}

// The keyword is a token, which a node pattern cannot name; a regex here ran on every statement
// of every block searched, so the text is split instead.
pattern is_const() {
  JsVariableDeclaration() as $declaration where {
    $around_keyword = split(string=$declaration, separator="const "),
    $before_keyword = $around_keyword[0],
    $before_keyword <: ""
  }
}

pattern unannotated($declarator) {
  $declarator where {
    ! $declarator <: JsVariableDeclarator(variable_annotation=TsTypeAnnotation())
  }
}

pattern array_name_0() {
  JsIdentifierExpression(name=$name) as $reference where {
    $reference <: within scope_of($name) as $scope ,
    $scope <: or {
      function_with(parameters=or {
        JsParameters(items=some array_parameter($name)),
        JsConstructorParameters(parameters=some array_parameter($name))
      }) where {
        ! $scope <: contains JsIdentifierAssignment() as $written where { $written <: $name }
      },
      statements_with(statement=declaring(declaration=JsVariableDeclaration(declarators=some JsVariableDeclarator(id=$name, variable_annotation=TsTypeAnnotation(ty=array_type()))) as $typed)) where {
        or {
          $typed <: is_const(),
          ! $scope <: contains JsIdentifierAssignment() as $rewritten where { $rewritten <: $name }
        }
      },
      statements_with(statement=declaring(declaration=and { JsVariableDeclaration(declarators=some unannotated(declarator=JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=bare(inner=JsArrayExpression()))))),
      is_const() }))
    }
  }
}

pattern array_0() {
  or {
    JsArrayExpression(),
    array_name_0()
  }
}

// The method name is tested before the receiver.
pattern array_call($receiver) {
  JsCallExpression(callee=member(object=$object, method=$returning)) where {
    $returning <: or {
      "map",
      "filter",
      "flatMap",
      "slice",
      "concat",
      "toSorted",
      "toReversed",
      "toSpliced"
    },
    $object <: bare(inner=$receiver)
  }
}

pattern array_1() {
  or {
    array_0(),
    array_call(receiver=array_0())
  }
}

pattern array_2() {
  or {
    array_1(),
    array_call(receiver=array_1())
  }
}

// A `const` alias of an array known without following another alias.
pattern array_name_1() {
  JsIdentifierExpression(name=$alias) as $reference where {
    $reference <: within scope_of(name=$alias) as $alias_scope ,
    $alias_scope <: statements_with(statement=declaring(declaration=and { JsVariableDeclaration(declarators=some unannotated(declarator=JsVariableDeclarator(id=$alias, initializer=JsInitializerClause(expression=bare(inner=array_2()))))),
    is_const() }))
  }
}

pattern array_3() {
  or {
    array_2(),
    array_name_1(),
    array_call(receiver=array_name_1()),
    array_call(receiver=array_call(receiver=array_name_1()))
  }
}

// A `const` alias of an alias.
pattern array_name_2() {
  JsIdentifierExpression(name=$second) as $reference where {
    $reference <: within scope_of(name=$second) as $second_scope ,
    $second_scope <: statements_with(statement=declaring(declaration=and { JsVariableDeclaration(declarators=some unannotated(declarator=JsVariableDeclarator(id=$second, initializer=JsInitializerClause(expression=bare(inner=array_3()))))),
    is_const() }))
  }
}

pattern array_4() {
  or {
    array_3(),
    array_name_2(),
    array_call(receiver=array_name_2())
  }
}

// The query names the two call forms directly and tests the method name first: this runs on
// every call in the tree, and a pattern call there cost 45 s.
or {
  JsCallExpression(callee=JsStaticMemberExpression(object=$first_call, member=$second_method)) where {
    $second_method <: or {
      "map",
      "filter"
    }
  },
  JsCallExpression(callee=JsComputedMemberExpression(object=$first_call, member=JsStringLiteralExpression() as $second_quoted)) where {
    $second_quoted <: or {
      "'map'" where { $second_method = "map" },
      r"\"map\"" where { $second_method = "map" },
      "'filter'" where { $second_method = "filter" },
      r"\"filter\"" where { $second_method = "filter" }
    }
  }
} as $second where {
  $first_call <: bare(inner=JsCallExpression(callee=member(object=$receiver, method=$first_method))),
  or {
    and { $second_method <: "map", $first_method <: "filter" },
    and { $second_method <: "filter", $first_method <: "map" }
  },
  $receiver <: bare(inner=array_4()),
  register_diagnostic(span=$second, message=join(list=[
    "[no-array-filter-map] `.",

    $first_method,

    "(…).",

    $second_method,

    "(…)` walks the array twice and builds one to throw away. Use `.values().",

    $first_method,

    "(…).",

    $second_method,

    "(…).toArray()`, or one `flatMap`; keep the callbacks' order and indexes as they are."
  ], separator=""), severity="error")
}
