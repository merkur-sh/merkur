engine biome(1.0)
language js(typescript, jsx)

// A call that replaces a module for the test run:
//   `vi.mock`, `vi.doMock`, `jest.mock`, `jest.doMock`, `jest.unstable_mockModule` (also by
//   computed string key), on the global `vi`/`jest` or on `vi` imported from 'vitest' / `jest`
//   imported from '@jest/globals' under any local name;
//   `mock.module`, on `mock` imported from 'bun:test' under any local name.
//
// Scope is not visible to GritQL. A name counts as the global when the file binds it nowhere, and
// as the import when the file imports it so; a local that shadows either inside one function is
// not told apart from it.

// A pattern cannot take a regex or a list of strings as an argument that is then matched against
// a module source (Biome 2.5.10 fails to compile the first), so the three imports are spelled out.
pattern vitest_vi($local) {
  JsImport() as $import where {
    $import <: contains JsModuleSource() as $from where {
      $from <: or {
        "'vitest'",
        r"\"vitest\""
      }
    },
    $import <: contains or {
      JsNamedImportSpecifier(name="vi", local_name=$local),
      JsShorthandNamedImportSpecifier(local_name=$local) where { $local <: "vi" }
    }
  }
}

pattern jest_globals_jest($local) {
  JsImport() as $import where {
    $import <: contains JsModuleSource() as $from where {
      $from <: or {
        "'@jest/globals'",
        r"\"@jest/globals\""
      }
    },
    $import <: contains or {
      JsNamedImportSpecifier(name="jest", local_name=$local),
      JsShorthandNamedImportSpecifier(local_name=$local) where { $local <: "jest" }
    }
  }
}

pattern bun_test_mock($local) {
  JsImport() as $import where {
    $import <: contains JsModuleSource() as $from where {
      $from <: or {
        "'bun:test'",
        r"\"bun:test\""
      }
    },
    $import <: contains or {
      JsNamedImportSpecifier(name="mock", local_name=$local),
      JsShorthandNamedImportSpecifier(local_name=$local) where { $local <: "mock" }
    }
  }
}

// `owner.method` or `owner['method']`, the method name without its quotes.
pattern method_of($owner, $method) {
  or {
    JsStaticMemberExpression(object=JsIdentifierExpression() as $owner, member=$method),
    JsComputedMemberExpression(object=JsIdentifierExpression() as $owner, member=JsStringLiteralExpression() as $quoted) where {
      $quoted <: or {
        "'mock'" where { $method = "mock" },
        r"\"mock\"" where { $method = "mock" },
        "'doMock'" where { $method = "doMock" },
        r"\"doMock\"" where { $method = "doMock" },
        "'unstable_mockModule'" where { $method = "unstable_mockModule" },
        r"\"unstable_mockModule\"" where { $method = "unstable_mockModule" },
        "'module'" where { $method = "module" },
        r"\"module\"" where { $method = "module" }
      }
    }
  }
}

JsCallExpression(callee=$callee) as $call where {
  // A substring test first: this runs on every call in the tree.
  $callee <: includes or {
    "mock",
    "Mock",
    "module"
  },
  $callee <: or {
    method_of($owner, $method),
    JsParenthesizedExpression(expression=method_of($owner, $method))
  },
  or {
    and {
      $method <: or {
        "mock",
        "doMock",
        "unstable_mockModule"
      },
      or {
        and {
          $owner <: or {
            "vi",
            "jest"
          },
          ! $program <: contains JsIdentifierBinding() as $binding where { $binding <: $owner }
        },
        $program <: contains vitest_vi(local=$owner),
        $program <: contains jest_globals_jest(local=$owner)
      }
    },
    and { $method <: "module", $program <: contains bun_test_mock(local=$owner) }
  },
  register_diagnostic(span=$call, message="[no-module-mocking] Replacing a module for the test run tests a program that does not ship. Pass the dependency in through its real interface: a service layer or a faithful test implementation.", severity="error")
}
