engine biome(1.0)
language js(typescript, jsx)

// `Reflect.apply(...)` and `Reflect['apply'](...)` on the global `Reflect`, with or without
// parentheses around the callee.
//
// Scope is not visible to GritQL: a file that binds its own `Reflect` anywhere (a constant, a
// parameter, an import) is skipped whole.

pattern reflect_method() {
  or {
    JsStaticMemberExpression(object=JsIdentifierExpression() as $owner, member="apply"),
    JsComputedMemberExpression(object=JsIdentifierExpression() as $owner, member=JsStringLiteralExpression() as $method) where {
      $method <: or {
        "'apply'",
        r"\"apply\""
      }
    }
  } where { $owner <: "Reflect" }
}

JsCallExpression(callee=$callee) as $call where {
  // A substring test first: this runs on every call in the tree.
  $callee <: includes "Reflect",
  $callee <: or {
    reflect_method(),
    JsParenthesizedExpression(expression=reflect_method()),
    JsParenthesizedExpression(expression=JsParenthesizedExpression(expression=reflect_method()))
  },
  ! $program <: contains JsIdentifierBinding() as $binding where { $binding <: "Reflect" },
  register_diagnostic(span=$call, message="[no-reflect-apply] `Reflect.apply` calls a function the compiler cannot check. Call the typed function directly; put dynamic dispatch behind a named interface.", severity="error")
}
