load("//tools/bazel/bun:rules.bzl", "bun_binary", "bun_compile")
load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*.ts", "**/*.json", "**/*.py", "**/*.sh", "**/*.toml", "**/*.yaml", "**/*.yml"], allow_empty = True))

js_library(
    name = "raw_sources",
    srcs = glob(["**/*.ts", "**/*.json"], allow_empty = True),
)

js_library(
    name = "sources",
    srcs = [":raw_sources"],
    deps = [
        "//:node_modules",
        "//:js_configuration",
        "//apps/server:sources",
        "//apps/daemon:sources",
        "//apps/web:sources",
        "//packages/auth:sources",
        "//packages/config:sources",
        "//packages/daemon-control-protocol:sources",
        "//packages/keyboard:sources",
        "//packages/logger:sources",
        "//packages/protocol:sources",
        "//packages/quicksilver:sources",
        "//packages/shared:sources",
        "//packages/user-agent:sources",
    ],
)

js_library(
    name = "junit_validator",
    srcs = ["verification-junit.ts"],
    deps = ["//:node_modules/fast-xml-parser", "//:js_configuration"],
)

filegroup(name = "verification_inputs", srcs = glob(["**"], exclude = ["node_modules/**", "dist/**", "target/**", "pkg/**", "**/pkg/**", "**/__pycache__/**", "**/*.pyc", "test-results/**", ".git/**", ".codegraph/**", ".tools/**", ".cache/**", "coverage/**", ".vite/**", ".env", ".env.*", "**/.env", "**/.env.*", ".bazelrc.local", "**/.bazelrc.local", "**/.DS_Store", ".DS_Store", ".*", ".*/**", "**/.*", "**/.*/**"], allow_empty = True) + glob(["**/.env.example", "**/.env.sample", "**/.env.template"], allow_empty = True))

bun_compile(name = "release_verifier", entry_point = "ci-release-verify.ts", data = [":sources", "//packages/e2e-wasm:wasm_artifacts"], defines = {"//tools/bazel/bun:release_mldsa87_public_key": "MERKUR_RELEASE_MLDSA87_PUBLIC_KEY"}, require_release_key = True, out = "verify.bin", tags = ["manual", "unqualified-native-runtime"])

js_library(
    name = "provision_ledger_sources",
    srcs = ["ci/provision-ledger.ts", "ci/provision-ledger.test.ts"],
    deps = ["//tools/bazel/verification:tooling_sources", "//tools/bazel/bun:owned_files_sources"],
)

bun_binary(
    name = "provision_ledger",
    entry_point = "ci/provision-ledger.ts",
    data = [":provision_ledger_sources"],
    tools = {"//tools/bazel/tools:controller_git": "git", "//tools/bazel/tools:controller_sh": "sh"},
    tool_environment = {"git": "MERKUR_VERIFICATION_GIT", "sh": "MERKUR_LEDGER_GIT_SHELL"},
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
)

bun_test(
    name = "provision_ledger_test",
    test_files = ["scripts/ci/provision-ledger.test.ts"],
    data = [":provision_ledger_sources"],
    tools = {"//tools/bazel/tools:git": "git"},
    tool_environment = {"git": "MERKUR_VERIFICATION_GIT"},
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
    tags = ["manual", "no-remote-cache", "unqualified-native-tool-matrix"],
)
