load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

exports_files([
    "bun.bzl",
    "link-bins.ts",
])

# The Bun release for the platform a target runs on.
alias(
    name = "bun",
    actual = select({
        ":darwin_aarch64": "@bun_darwin_aarch64//:bun",
        ":darwin_x64": "@bun_darwin_x64//:bun",
        ":linux_aarch64": "@bun_linux_aarch64//:bun",
        ":linux_x64": "@bun_linux_x64//:bun",
    }),
)

# The real Node executable for the target platform, without a host shell wrapper.
alias(
    name = "node",
    actual = select({
        ":darwin_aarch64": "@nodejs_darwin_arm64//:node_bin",
        ":darwin_x64": "@nodejs_darwin_amd64//:node_bin",
        ":linux_aarch64": "@nodejs_linux_arm64//:node_bin",
        ":linux_x64": "@nodejs_linux_amd64//:node_bin",
    }),
)

[config_setting(
    name = "%s_%s" % (os_key, cpu_key),
    constraint_values = [
        "@platforms//os:" + os,
        "@platforms//cpu:" + cpu,
    ],
) for os_key, os in [
    ("darwin", "macos"),
    ("linux", "linux"),
] for cpu_key, cpu in [
    ("aarch64", "aarch64"),
    ("x64", "x86_64"),
]]
