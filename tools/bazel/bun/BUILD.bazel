package(default_visibility = ["//visibility:public"])

exports_files(["bun.bzl"])

# The Bun release for the platform a target runs on.
alias(
    name = "bun",
    actual = select({
        ":darwin_aarch64": "@bun_darwin_aarch64//:bun",
        ":darwin_x64": "@bun_darwin_x64//:bun",
        ":linux_aarch64": "@bun_linux_aarch64//:bun",
        ":linux_x64": "@bun_linux_x64//:bun",
    }),
)

[config_setting(
    name = "%s_%s" % (os_key, cpu_key),
    constraint_values = [
        "@platforms//os:" + os,
        "@platforms//cpu:" + cpu,
    ],
) for os_key, os in [
    ("darwin", "macos"),
    ("linux", "linux"),
] for cpu_key, cpu in [
    ("aarch64", "aarch64"),
    ("x64", "x86_64"),
]]
