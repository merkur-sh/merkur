load("@rules_cc//cc:defs.bzl", "cc_test", "cc_toolchain")
load(":config.bzl", "native_config")

package(default_visibility = ["//visibility:public"])

filegroup(name = "verification_inputs", srcs = glob(["*.sh", "*.bzl", "*.cpp", "BUILD.bazel"]))
filegroup(name = "tools", srcs = glob(["*.sh"]))

constraint_setting(name = "sdk")
constraint_value(name = "gcc_14_3_bookworm", constraint_setting = ":sdk")
# An executor that holds the pinned Xcode 26.5 (17F42) compiler/SDK export.
constraint_value(name = "xcode_26_5_17f42", constraint_setting = ":sdk")

native_config(name = "config", cpu = "x86_64")
native_config(name = "arm64_config", cpu = "aarch64")

cc_toolchain(
    name = "cc",
    toolchain_identifier = "gcc-14.3-bookworm-x86_64",
    toolchain_config = ":config",
    all_files = ":tools",
    ar_files = ":tools",
    as_files = ":tools",
    compiler_files = ":tools",
    dwp_files = ":tools",
    linker_files = ":tools",
    objcopy_files = ":tools",
    strip_files = ":tools",
    supports_param_files = 1,
)

cc_toolchain(
    name = "arm64_cc",
    toolchain_identifier = "gcc-14.3-bookworm-aarch64",
    toolchain_config = ":arm64_config",
    all_files = ":tools",
    ar_files = ":tools",
    as_files = ":tools",
    compiler_files = ":tools",
    dwp_files = ":tools",
    linker_files = ":tools",
    objcopy_files = ":tools",
    strip_files = ":tools",
    supports_param_files = 1,
)

toolchain(
    name = "linux_x64",
    toolchain = ":cc",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64", ":gcc_14_3_bookworm"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)

toolchain(
    name = "linux_arm64",
    toolchain = ":arm64_cc",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64", ":gcc_14_3_bookworm"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64"],
)

cc_test(
    name = "native_sdk_qualification",
    srcs = ["qualification.cpp"],
    tags = ["manual", "external", "no-cache", "unqualified-native-sdk"],
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "short",
)
