

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["cc.MODULE.bazel", "sdk.BUILD.bazel"])

filegroup(name="verification_inputs",srcs=glob(["**"], exclude=["**/.*", "**/.*/**", "**/__pycache__/**", "**/*.pyc"]))

cc_library(
    name = "wasm_c_qualification",
    srcs = ["wasm_c_qualification.c"],
    target_compatible_with = ["@platforms//cpu:wasm32", "@platforms//os:none"],
    tags = ["manual"],
)



toolchain(name="wasi_sdk_arm64_linux_toolchain",toolchain="@wasi_sdk_arm64_linux//:cc",toolchain_type="@bazel_tools//tools/cpp:toolchain_type",exec_compatible_with=["@platforms//cpu:aarch64","@platforms//os:linux"],target_compatible_with=["@platforms//cpu:wasm32","@platforms//os:none"])



toolchain(name="wasi_sdk_arm64_macos_toolchain",toolchain="@wasi_sdk_arm64_macos//:cc",toolchain_type="@bazel_tools//tools/cpp:toolchain_type",exec_compatible_with=["@platforms//cpu:aarch64","@platforms//os:osx"],target_compatible_with=["@platforms//cpu:wasm32","@platforms//os:none"])



toolchain(name="wasi_sdk_x86_64_linux_toolchain",toolchain="@wasi_sdk_x86_64_linux//:cc",toolchain_type="@bazel_tools//tools/cpp:toolchain_type",exec_compatible_with=["@platforms//cpu:x86_64","@platforms//os:linux"],target_compatible_with=["@platforms//cpu:wasm32","@platforms//os:none"])



toolchain(name="wasi_sdk_x86_64_macos_toolchain",toolchain="@wasi_sdk_x86_64_macos//:cc",toolchain_type="@bazel_tools//tools/cpp:toolchain_type",exec_compatible_with=["@platforms//cpu:x86_64","@platforms//os:osx"],target_compatible_with=["@platforms//cpu:wasm32","@platforms//os:none"])
