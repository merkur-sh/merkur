+// This directory belongs to this one metadata action, never to retained worker state.
+struct MetadataScratch {
+    path: std::path::PathBuf,
+    identity: std::fs::Metadata,
+    active: bool,
+}
+
+impl MetadataScratch {
+    fn create(path: &str) -> Result<Self, ProcessWrapperError> {
+        if path.starts_with('/') || path.split('/').any(|part| matches!(part, "" | "." | "..")) {
+            return Err(ProcessWrapperError("metadata scratch must be an execution-root-relative path".to_owned()));
+        }
+        let path = std::env::current_dir().map_err(|e| ProcessWrapperError(e.to_string()))?.join(path);
+        // create_dir refuses an existing directory, File or alias; no prior state is reused.
+        std::fs::create_dir(&path).map_err(|e| ProcessWrapperError(format!("failed to create fresh metadata scratch: {e}")))?;
+        let identity = std::fs::symlink_metadata(&path).map_err(|e| ProcessWrapperError(e.to_string()))?;
+        Ok(Self { path, identity, active: true })
+    }
+
+    fn cleanup(&mut self) -> Result<(), ProcessWrapperError> {
+        if !self.active { return Ok(()); }
+        let current = std::fs::symlink_metadata(&self.path).map_err(|e| ProcessWrapperError(e.to_string()))?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            if current.dev() != self.identity.dev() || current.ino() != self.identity.ino() {
+                return Err(ProcessWrapperError("metadata scratch ownership changed".to_owned()));
+            }
+        }
+        if !current.is_dir() || current.file_type().is_symlink() {
+            return Err(ProcessWrapperError("metadata scratch is no longer the owned directory".to_owned()));
+        }
+        std::fs::remove_dir_all(&self.path).map_err(|e| ProcessWrapperError(format!("failed to retire metadata scratch: {e}")))?;
+        self.active = false;
+        Ok(())
+    }
+}
+
+impl Drop for MetadataScratch {
+    fn drop(&mut self) {
+        if let Err(error) = self.cleanup() { eprintln!("{error}"); }
+    }
+}
