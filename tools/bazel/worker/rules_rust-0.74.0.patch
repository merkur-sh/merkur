+fn prepare_napi_type_def_dir(
+    directory: &str,
+    root: &std::path::Path,
+    environment: &mut HashMap<String, String>,
+) -> Result<(), OptionError> {
+    let path = std::path::Path::new(directory);
+    if directory.is_empty()
+        || directory
+            .split('/')
+            .any(|part| part.is_empty() || part == "." || part == "..")
+        || directory.contains('\\')
+        || path.is_absolute()
+        || path
+            .components()
+            .any(|part| !matches!(part, std::path::Component::Normal(_)))
+    {
+        return Err(OptionError::Generic(
+            "invalid declared NAPI directory".to_owned(),
+        ));
+    }
+    let package = environment.get("CARGO_PKG_NAME").ok_or_else(|| {
+        OptionError::Generic("NAPI type definitions require CARGO_PKG_NAME".to_owned())
+    })?;
+    if package.is_empty()
+        || !package
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'_')
+    {
+        return Err(OptionError::Generic(
+            "invalid NAPI Cargo package name".to_owned(),
+        ));
+    }
+    let absolute = root.join(path);
+    match std::fs::create_dir(&absolute) {
+        Ok(()) => (),
+        Err(e) if e.kind() == io::ErrorKind::AlreadyExists => {
+            let info = std::fs::symlink_metadata(&absolute)
+                .map_err(|e| OptionError::Generic(e.to_string()))?;
+            if !info.is_dir()
+                || info.file_type().is_symlink()
+                || std::fs::read_dir(&absolute)
+                    .map_err(|e| OptionError::Generic(e.to_string()))?
+                    .next()
+                    .is_some()
+            {
+                return Err(OptionError::Generic(
+                    "NAPI output directory is not an empty ordinary directory".to_owned(),
+                ));
+            }
+        }
+        Err(e) => return Err(OptionError::Generic(e.to_string())),
+    }
+    environment.insert(
+        "NAPI_TYPE_DEF_TMP_FOLDER".to_owned(),
+        absolute.to_string_lossy().into_owned(),
+    );
+    Ok(())
+}
