+//! Exact compiler-child ownership for the opt-in incremental worker.
+//! The wrapper stays single-threaded. A handler only records cancellation and calls
+//! async-signal-safe kill; the PID remains unreaped until cancellation is blocked.
+use std::io;
+use std::process::{Child, ExitStatus};
+
+#[cfg(target_os = "macos")]
+mod darwin {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, AtomicI32, Ordering};
+    static CHILD: AtomicI32 = AtomicI32::new(0);
+    static CANCELLED: AtomicBool = AtomicBool::new(false);
+    const SIGTERM: i32 = 15;
+    const SIGKILL: i32 = 9;
+    // Darwin SDK sys/signal.h and sys/wait.h, identical on supported 64-bit CPUs.
+    #[repr(C)]
+    struct SigInfo {
+        integers: [i32; 6],
+        address: *mut std::ffi::c_void,
+        value: usize,
+        band: i64,
+        pad: [usize; 7],
+    }
+    unsafe extern "C" {
+        fn signal(signo: i32, handler: usize) -> usize;
+        fn __error() -> *mut i32;
+        fn kill(pid: i32, signal: i32) -> i32;
+        fn sigprocmask(how: i32, set: *const u32, old: *mut u32) -> i32;
+        fn waitid(kind: i32, pid: u32, info: *mut SigInfo, options: i32) -> i32;
+    }
+    extern "C" fn cancel(_signal: i32) {
+        let saved_errno = unsafe { *__error() };
+        CANCELLED.store(true, Ordering::SeqCst);
+        let pid = CHILD.load(Ordering::SeqCst);
+        if pid != 0 { unsafe { kill(pid, SIGKILL); } }
+        unsafe { *__error() = saved_errno; }
+    }
+    pub fn install() -> io::Result<()> {
+        if unsafe { signal(SIGTERM, cancel as *const () as usize) } == usize::MAX {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    }
+    pub fn publish(pid: u32) {
+        CHILD.store(pid as i32, Ordering::SeqCst);
+        // Cancellation between spawn and PID publication cannot lose the child.
+        if CANCELLED.load(Ordering::SeqCst) { unsafe { kill(pid as i32, SIGKILL); } }
+    }
+    pub fn exited(pid: u32) -> io::Result<()> {
+        loop {
+            let mut info = std::mem::MaybeUninit::<SigInfo>::zeroed();
+            if unsafe { waitid(1, pid, info.as_mut_ptr(), 0x4 | 0x20) } == 0 { return Ok(()); }
+            let failure = io::Error::last_os_error();
+            if failure.kind() != io::ErrorKind::Interrupted { return Err(failure); }
+        }
+    }
+    pub struct Blocked(u32);
+    impl Blocked {
+        pub fn new() -> io::Result<Self> {
+            let signal = 1_u32 << (SIGTERM - 1);
+            let mut previous = 0;
+            if unsafe { sigprocmask(1, &signal, &mut previous) } != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(Self(previous))
+        }
+    }
+    impl Drop for Blocked {
+        fn drop(&mut self) { unsafe { sigprocmask(3, &self.0, std::ptr::null_mut()); } }
+    }
+    pub fn clear() { CHILD.store(0, Ordering::SeqCst); }
+}
+
+// Linux wrapper is PID 1 inside the mandatory worker process_scope namespace.
+// Killing that init through the owner-bound supervisor tears down all descendants;
+// this handler additionally owns the exact direct compiler child on wrapper errors
+// and SIGTERM, without permitting PID reuse between cancellation and reaping.
+#[cfg(target_os = "linux")]
+mod linux {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, AtomicI32, Ordering};
+    static CHILD: AtomicI32 = AtomicI32::new(0);
+    static CANCELLED: AtomicBool = AtomicBool::new(false);
+    const SIGTERM: i32 = 15;
+    const SIGKILL: i32 = 9;
+    // The supported Linux x86_64/aarch64 libc sigset_t is 1024 bits. waitid's
+    // siginfo_t is 128 bytes; no fields are interpreted or inferred here.
+    #[repr(C)]
+    struct SignalSet([u64; 16]);
+    #[repr(C, align(8))]
+    struct SignalInfo([u8; 128]);
+    unsafe extern "C" {
+        fn getpid() -> i32;
+        fn signal(signo: i32, handler: usize) -> usize;
+        fn __errno_location() -> *mut i32;
+        fn kill(pid: i32, signal: i32) -> i32;
+        fn sigprocmask(how: i32, set: *const SignalSet, old: *mut SignalSet) -> i32;
+        fn waitid(kind: i32, pid: u32, info: *mut SignalInfo, options: i32) -> i32;
+    }
+    extern "C" fn cancel(_signal: i32) {
+        let saved_errno = unsafe { *__errno_location() };
+        CANCELLED.store(true, Ordering::SeqCst);
+        let pid = CHILD.load(Ordering::SeqCst);
+        if pid != 0 { unsafe { kill(pid, SIGKILL); } }
+        unsafe { *__errno_location() = saved_errno; }
+    }
+    pub fn install() -> io::Result<()> {
+        if unsafe { getpid() } != 1 {
+            return Err(io::Error::other("Linux compiler wrapper is not namespace init"));
+        }
+        if unsafe { signal(SIGTERM, cancel as *const () as usize) } == usize::MAX {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    }
+    pub fn publish(pid: u32) {
+        CHILD.store(pid as i32, Ordering::SeqCst);
+        if CANCELLED.load(Ordering::SeqCst) { unsafe { kill(pid as i32, SIGKILL); } }
+    }
+    pub fn exited(pid: u32) -> io::Result<()> {
+        loop {
+            let mut info = std::mem::MaybeUninit::<SignalInfo>::zeroed();
+            // P_PID, WEXITED | WNOWAIT: keep the PID owned until SIGTERM is blocked.
+            if unsafe { waitid(1, pid, info.as_mut_ptr(), 0x4 | 0x0100_0000) } == 0 {
+                return Ok(());
+            }
+            let failure = io::Error::last_os_error();
+            if failure.kind() != io::ErrorKind::Interrupted { return Err(failure); }
+        }
+    }
+    pub struct Blocked(SignalSet);
+    impl Blocked {
+        pub fn new() -> io::Result<Self> {
+            let mut signals = SignalSet([0; 16]);
+            signals.0[0] = 1_u64 << (SIGTERM - 1);
+            let mut previous = SignalSet([0; 16]);
+            // SIG_BLOCK. This is the libc interface, not rt_sigprocmask's ABI.
+            if unsafe { sigprocmask(0, &signals, &mut previous) } != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(Self(previous))
+        }
+    }
+    impl Drop for Blocked {
+        fn drop(&mut self) {
+            // SIG_SETMASK; CHILD has already been cleared before unblocking.
+            unsafe { sigprocmask(2, &self.0, std::ptr::null_mut()); }
+        }
+    }
+    pub fn clear() { CHILD.store(0, Ordering::SeqCst); }
+    pub fn completed() -> io::Result<()> {
+        if CANCELLED.load(Ordering::SeqCst) {
+            return Err(io::Error::new(io::ErrorKind::Interrupted, "compiler child cancelled"));
+        }
+        Ok(())
+    }
+}
+
+#[cfg(target_os = "macos")]
+use darwin as lifecycle;
+#[cfg(target_os = "linux")]
+use linux as lifecycle;
+
+pub fn install(cooperative: bool) -> io::Result<()> {
+    #[cfg(any(target_os = "macos", target_os = "linux"))]
+    if cooperative { lifecycle::install()?; }
+    #[cfg(not(any(target_os = "macos", target_os = "linux")))]
+    if cooperative { return Err(io::Error::other("unqualified compiler-child cancellation platform")); }
+    Ok(())
+}
+
+pub struct OwnedChild { child: Child, cooperative: bool, reaped: bool }
+impl OwnedChild {
+    pub fn new(child: Child, cooperative: bool) -> Self {
+        #[cfg(any(target_os = "macos", target_os = "linux"))]
+        if cooperative { lifecycle::publish(child.id()); }
+        Self { child, cooperative, reaped: false }
+    }
+    pub fn take_stderr(&mut self) -> Option<std::process::ChildStderr> { self.child.stderr.take() }
+    pub fn kill(&mut self) -> io::Result<()> { self.child.kill() }
+    pub fn wait(&mut self) -> io::Result<ExitStatus> {
+        #[cfg(any(target_os = "macos", target_os = "linux"))]
+        let _blocked = if self.cooperative {
+            lifecycle::exited(self.child.id())?;
+            Some(lifecycle::Blocked::new()?)
+        } else { None };
+        let status = self.child.wait()?;
+        self.reaped = true;
+        #[cfg(any(target_os = "macos", target_os = "linux"))]
+        if self.cooperative { lifecycle::clear(); }
+        #[cfg(target_os = "linux")]
+        if self.cooperative {
+            drop(_blocked);
+            linux::completed()?;
+        }
+        Ok(status)
+    }
+}
+impl Drop for OwnedChild {
+    fn drop(&mut self) {
+        if self.reaped { return; }
+        // No wrapper error can orphan the leaf, including stderr parser/I/O failures.
+        let _ = self.child.kill();
+        let _ = self.wait();
+    }
+}
