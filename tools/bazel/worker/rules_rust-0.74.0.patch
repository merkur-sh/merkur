+#[cfg(target_os = "macos")]
+fn confine_wrapper(profile: &str) -> Result<(), ProcessWrapperError> {
+    use std::ffi::{CStr, CString};
+    #[link(name = "sandbox")]
+    unsafe extern "C" {
+        fn sandbox_init(profile: *const std::ffi::c_char, flags: u64, error: *mut *mut std::ffi::c_char) -> std::ffi::c_int;
+        fn sandbox_free_error(error: *mut std::ffi::c_char);
+    }
+    let profile = CString::new(profile).map_err(|e| ProcessWrapperError(e.to_string()))?;
+    let mut detail = std::ptr::null_mut();
+    unsafe {
+        if sandbox_init(profile.as_ptr(), 0, &mut detail) != 0 {
+            let message = if detail.is_null() {
+                "wrapper sandbox initialization failed".to_owned()
+            } else {
+                let message = CStr::from_ptr(detail).to_string_lossy().into_owned();
+                sandbox_free_error(detail);
+                message
+            };
+            return Err(ProcessWrapperError(message));
+        }
+    }
+    Ok(())
+}
+#[cfg(target_os = "linux")]
+fn confine_wrapper(_profile: &str) -> Result<(), ProcessWrapperError> {
+    use std::ffi::{c_int, c_ulong};
+    #[repr(C)]
+    struct Header { version: u32, pid: i32 }
+    #[repr(C)]
+    #[derive(Clone, Copy)]
+    struct Capabilities { effective: u32, permitted: u32, inheritable: u32 }
+    unsafe extern "C" {
+        fn prctl(option: c_int, ...) -> c_int;
+        fn capget(header: *const Header, data: *mut Capabilities) -> c_int;
+        fn getpid() -> c_int;
+    }
+    let header = Header { version: 0x20080522, pid: 0 };
+    let mut data = [Capabilities { effective: 0, permitted: 0, inheritable: 0 }; 2];
+    // The worker's supervisor makes this exact wrapper namespace init. The outer
+    // confiner has already closed ambient FDs and installed immutable mounts before
+    // any option/env/status File parser runs. The leaf gets a tighter filter itself.
+    if unsafe { getpid() } != 1
+        || unsafe { prctl(39, 0 as c_ulong, 0 as c_ulong, 0 as c_ulong, 0 as c_ulong) } != 1
+        || unsafe { prctl(21, 0 as c_ulong, 0 as c_ulong, 0 as c_ulong, 0 as c_ulong) } != 2
+        || unsafe { capget(&header, data.as_mut_ptr()) } != 0
+        || data.iter().any(|c| c.effective | c.permitted | c.inheritable != 0)
+    {
+        return Err(ProcessWrapperError("missing mandatory Linux namespace confinement".to_owned()));
+    }
+    Ok(())
+}
