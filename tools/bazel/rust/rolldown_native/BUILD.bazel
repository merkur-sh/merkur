load("//tools/bazel/rust/acquire:sdk_rules.bzl", "cargo_acquisition_sdk")
load("//tools/bazel/rust:rolldown.bzl", "rolldown_compiler_context")
load("@merkur_rolldown_source//:sources.bzl", "ROLLDOWN_SOURCE_FILES")
load(":registry.bzl", "ROLLDOWN_REGISTRY_ARCHIVES")
load(":units.bzl", "declare_rolldown_units")

package(default_visibility = ["//visibility:public"])
exports_files(["crates.MODULE.bazel", "registry.MODULE.bazel", "captured-context.json", "units.bzl", "registry.bzl"])
filegroup(name = "verification_inputs", srcs = glob(["*"]))

cargo_acquisition_sdk(
    name = "acquisition_sdk",
    execution_host = "aarch64-apple-darwin",
    source_files = ROLLDOWN_SOURCE_FILES,
    locks = ["Cargo.lock"],
    archives = ROLLDOWN_REGISTRY_ARCHIVES,
    target_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    tags = ["manual"],
)
rolldown_compiler_context(
    name = "compiler_context",
    sdk = ":acquisition_sdk",
    source_archive = "@merkur_rolldown_original_archive//file",
    source_instance = "workspace",
    tags = ["manual"],
)
declare_rolldown_units(sdk = ":acquisition_sdk", compiler_context = ":compiler_context")
