def declare_rust_package(package):
    tests = []
    for name, declaration in _PACKAGES[package].items():
        if declaration["kind"] == "test":
            if package == "merkur-image-worker" and name in ["test_composition", "test_descriptor", "test_encoding_allocations", "test_isolation"]:
                configured_public_rust_test(name = name + "__darwin", binary = select(declaration["targets"]), target_compatible_with = ["@platforms//os:macos"], tags = confinement_test_tags(package, name, "aarch64-apple-darwin"))
                configured_public_rust_test(name = name + "__linux", binary = select(declaration["targets"]), target_compatible_with = ["@platforms//os:linux"], tags = ["manual"])
                native.alias(name = name, actual = select({"//tools/bazel/rust/units:darwin_confinement": ":" + name + "__darwin", "//conditions:default": ":" + name + "__linux"}), tags = ["manual"])
            else:
                configured_public_rust_test(name = name, binary = select(declaration["targets"]), tags = ["manual"])
            tests.append(":" + name)
        else:
            native.alias(name = name, actual = select(declaration["targets"]), tags = ["manual"])
    native.test_suite(name = "tests", tests = tests, tags = ["manual"])
