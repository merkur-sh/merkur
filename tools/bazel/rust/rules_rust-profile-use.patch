 # buildifier: disable=unnamed-macro
+def profile_use():
+    """The LLVM profile every non-exec rustc compilation optimizes with: `-Cprofile-use`.
+
+    A label flag that names the merged `.profdata`; its default names no file, and no flag is
+    passed. Set it through a transition to build a whole graph profile-guided, as Cargo does
+    with `-Cprofile-use` in its rustflags.
+    """
+    native.filegroup(
+        name = "no_profile",
+        visibility = ["//visibility:public"],
+    )
+    native.label_flag(
+        name = "profile_use",
+        build_setting_default = ":no_profile",
+    )
+
