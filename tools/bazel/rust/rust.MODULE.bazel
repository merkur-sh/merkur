    build_file = "//tools/bazel/rust:crate_sources.BUILD.bazel",
)

# CargoShear's exact source analyzer, independent of product compiler roots.
shear_crate = use_extension("//tools/bazel/rust:shear_extension.bzl", "crate")
shear_crate.splicing_config(resolver_version = "3")
shear_crate.render_config(regen_command = "bazel mod deps")
shear_crate.from_cargo(
    host_tools = "@merkur_rust_host_tools//:BUILD.bazel",
    name = "crates_shear_tools",
    lockfile = "//tools/bazel/rust/shear_tools:Bazel.lock",
    cargo_lockfile = "//tools/bazel/rust/shear_tools:Cargo.lock",
    manifests = ["//tools/bazel/rust/shear_tools:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["aarch64-apple-darwin", "x86_64-apple-darwin", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"],
)
use_repo(shear_crate, "crates_shear_tools")
policy_archive(
    name = "cargo_shear_source",
    urls = ["https://static.crates.io/crates/cargo-shear/cargo-shear-1.13.2.crate"],
    sha256 = "58276de72db535c9620d9ba07369dc08479cc0af39afebc386cceca207bebd81",
    strip_prefix = "cargo-shear-1.13.2",
    type = "tar.gz",
    patches = ["//tools/bazel/rust/shear_tools:cargo-shear-1.13.2-metadata.patch"],
    patch_args = ["-p1"],
    build_file = "//tools/bazel/rust:crate_sources.BUILD.bazel",
)

