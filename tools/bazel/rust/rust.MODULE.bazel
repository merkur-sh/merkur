    urls = ["https://static.rust-lang.org/dist/2026-05-28/rustc-1.96.0-aarch64-apple-darwin.tar.xz"],
    sha256 = "1bb7b0bad1d2a42fc4173ede6dd460de2774fc1858a8369329d3e081e4e3426c",
    downloaded_file_path = "rustc-1.96.0-aarch64-apple-darwin.tar.xz",
)
acquisition_archive(
    name = "merkur_worker_stage0_cargo",
    urls = ["https://static.rust-lang.org/dist/2026-05-28/cargo-1.96.0-aarch64-apple-darwin.tar.xz"],
    sha256 = "c042858192b7b6d66fe59b3bbbbd0f6e3cac6e8a478dc4cc091cde9eddea3c8b",
    downloaded_file_path = "cargo-1.96.0-aarch64-apple-darwin.tar.xz",
)
acquisition_archive(
    name = "merkur_worker_stage0_std",
    urls = ["https://static.rust-lang.org/dist/2026-05-28/rust-std-1.96.0-aarch64-apple-darwin.tar.xz"],
    sha256 = "439c4f71060b913e00db3a2e01340b2da0aa49978b843e36871f3250267c63f8",
    downloaded_file_path = "rust-std-1.96.0-aarch64-apple-darwin.tar.xz",
)
acquisition_archive(
    name = "merkur_worker_bootstrap_llvm",
    urls = ["https://ci-artifacts.rust-lang.org/rustc-builds/8bab26f4f68e0e26f0bb7960be334d5b520ea452/rust-dev-1.97.1-aarch64-apple-darwin.tar.xz"],
    sha256 = "e0523e176187712723b3c63d52b461cb49e6bb7bb6a59e02ae115c904e409bdf",
    downloaded_file_path = "rust-dev-1.97.1-aarch64-apple-darwin.tar.xz",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.splicing_config(resolver_version = "3")
resolution_host = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
resolution_host.host_tools(name = "merkur_rust_host_tools", version = "1.97.1", rustfmt_version = "1.97.1")
use_repo(resolution_host, "merkur_rust_host_tools")
# Specialized diagnostic resolution must not alter production versions/features.
crate.from_cargo(
    host_tools = "@merkur_rust_host_tools//:BUILD.bazel",
    name = "crates_ownership",
    cargo_lockfile = "//tools/ownership-proofs:Cargo.lock",
    manifests = ["//tools/ownership-proofs:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    host_tools = "@merkur_rust_host_tools//:BUILD.bazel",
    name = "crates_profile",
    cargo_lockfile = "//tools/edge-kernel-profile:Cargo.lock",
    manifests = ["//tools/edge-kernel-profile:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates_ownership", "crates_profile")

kani = use_extension("//tools/bazel/rust:kani_repositories.bzl", "kani")
use_repo(kani, "kani_darwin_arm64", "kani_darwin_x64", "kani_linux_arm64", "kani_linux_x64")
register_toolchains("//tools/bazel/rust:kani_darwin_arm64", "//tools/bazel/rust:kani_darwin_x64", "//tools/bazel/rust:kani_linux_arm64", "//tools/bazel/rust:kani_linux_x64")

# Locked metadata parser; this tool graph is independent of shipping features.
crate.from_cargo(
    host_tools = "@merkur_rust_host_tools//:BUILD.bazel",
    name = "crates_parser",
    cargo_lockfile = "//tools/bazel/rust/parser:Cargo.lock",
    manifests = ["//tools/bazel/rust/parser:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["aarch64-apple-darwin", "x86_64-apple-darwin", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates_parser")

# Exact policy interpreter source; no installed Cargo plugin or compiler wrapper.
crate.from_cargo(
    host_tools = "@merkur_rust_host_tools//:BUILD.bazel",
    name = "crates_policy_tools",
    cargo_lockfile = "//tools/bazel/rust/policy_tools:Cargo.lock",
    manifests = ["//tools/bazel/rust/policy_tools:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["aarch64-apple-darwin", "x86_64-apple-darwin", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates_policy_tools")

policy_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
policy_archive(
    name = "cargo_vet_source",
    urls = ["https://static.crates.io/crates/cargo-vet/cargo-vet-0.10.2.crate"],
    sha256 = "dd93790018205cbbfa161f078ca4631afa8ed57fc8f32482268bcfdf0c0d7499",
    strip_prefix = "cargo-vet-0.10.2",
    type = "tar.gz",
    patches = ["//tools/bazel/rust/policy_tools:cargo-vet-0.10.2-metadata.patch"],
    patch_args = ["-p1"],
    build_file = "//tools/bazel/rust:crate_sources.BUILD.bazel",
)

crate.from_cargo(
    host_tools = "@merkur_rust_host_tools//:BUILD.bazel",
    name = "crates_deny_tools",
    cargo_lockfile = "//tools/bazel/rust/deny_tools:Cargo.lock",
    manifests = ["//tools/bazel/rust/deny_tools:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["aarch64-apple-darwin", "x86_64-apple-darwin", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates_deny_tools")
policy_archive(
    name = "cargo_deny_source",
    urls = ["https://static.crates.io/crates/cargo-deny/cargo-deny-0.20.2.crate"],
    sha256 = "e528dfcbe739af7ce37a77d3d6df1b29dd6887b1c701d888820c0f16b864f737",
    strip_prefix = "cargo-deny-0.20.2",
    type = "tar.gz",
