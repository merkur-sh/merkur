# Included by MODULE.bazel. Cargo performs locked dependency resolution only.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.97.1"],
    rustfmt_version = "1.97.1",
    rust_analyzer_version = "1.97.1",
    extra_target_triples = ["wasm32-unknown-unknown", "aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Qualification source is an original File; extraction remains a declared action.
acquisition_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
acquisition_archive(
    name = "merkur_acquisition_itoa_archive",
    urls = ["https://static.crates.io/crates/itoa/itoa-1.0.18.crate"],
    sha256 = "8f42a60cbdf9a97f5d2305f08a87dc4e09308d1276d28c869c684d7777685682",
    downloaded_file_path = "itoa-1.0.18.crate",
)
acquisition_archive(
    name = "merkur_worker_compiler_source",
    urls = ["https://static.rust-lang.org/dist/rustc-1.97.1-src.tar.xz"],
    sha256 = "0ed06fdaffd4722a7702e0b4eebfafc897ab8f513e8e1b247cdd7e5c6df6ded2",
    downloaded_file_path = "rustc-1.97.1-src.tar.xz",
)
acquisition_archive(
