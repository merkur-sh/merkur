load(":node-binding-test.bzl", "node_binding_test")
load("//tools/bazel/bun:rules.bzl", "bun_test")
load(":node.bzl", "node_executable")
load(":sdk-image.bzl", "sdk_image_tool")

package(default_visibility = ["//visibility:public"])

filegroup(name = "verification_inputs", srcs = glob(["*.bzl", "*.ts", "BUILD.bazel"]))

node_executable(name = "node")

alias(
    name = "sh",
    actual = select({
        "@platforms//os:macos": "//tools/bazel/tools/native:sh",
        "@platforms//os:linux": ":linux_sh",
    }, no_match_error = "The shell requires a declared native execution SDK"),
)

alias(name = "python3", actual = "//tools/bazel/tools/native:python3")

# Verification controllers and ledger acquisition bind Git with its own SDK shell.
[
    alias(
        name = "controller_" + name,
        actual = select({
            "@platforms//os:macos": "//tools/bazel/tools/native:source_" + name,
            "@platforms//os:linux": ":linux_" + name,
        }, no_match_error = "The controller requires a declared native execution SDK"),
    )
    for name in ["git", "sh"]
]

[
    alias(
        name = name,
        actual = select({
            "@platforms//os:macos": "//tools/bazel/tools/native:" + name,
            "@platforms//os:linux": ":linux_" + name,
        }, no_match_error = "This utility requires a declared native execution SDK"),
    )
    for name in ["mkdir", "chmod", "echo", "git", "tar", "gzip", "openssl"]
]

# These tools are part of the exact GNU SDK image, rather than host executables.
# The configured child-tool platform must carry the GNU SDK constraint.
[
    sdk_image_tool(
        name = "linux_" + name,
        path = path,
        target_compatible_with = ["@platforms//os:linux", "//tools/bazel/cc/native:gcc_14_3_bookworm"],
    )
    for name, path in {
        "sh": "/bin/sh",
        "mkdir": "/usr/bin/mkdir",
        "chmod": "/usr/bin/chmod",
        "echo": "/usr/bin/echo",
        "git": "/usr/bin/git",
        "tar": "/usr/bin/tar",
        "gzip": "/usr/bin/gzip",
        "python3": "/usr/bin/python3",
        "openssl": "/usr/bin/openssl",
    }.items()
]

bun_test(
    name = "linux_sdk_tools_test",
    data = ["linux-sdk-tools.test.ts"],
    test_files = ["tools/bazel/tools/linux-sdk-tools.test.ts"],
    tools = {
        ":linux_sh": "sh",
        ":linux_mkdir": "mkdir",
        ":linux_chmod": "chmod",
        ":linux_echo": "echo",
        ":linux_git": "git",
        ":linux_tar": "tar",
        ":linux_gzip": "gzip",
        ":linux_python3": "python3",
        ":linux_openssl": "openssl",
    },
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
    target_compatible_with = ["@platforms//os:linux", "//tools/bazel/cc/native:gcc_14_3_bookworm"],
    tags = ["manual", "external", "no-cache", "unqualified-native-tool-matrix"],
    timeout = "short",
)

bun_test(
    name = "node_test",
    data = ["node.test.ts"],
    test_files = ["tools/bazel/tools/node.test.ts"],
    tools = {":node": "node"},
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
    tags = ["manual", "external", "no-cache", "unqualified-native-tool-matrix"],
    timeout = "short",
)

exports_files(["sdk_git.bzl"])

# The same original runtime toolchain native File and distribution resources.
config_setting(name = "node_is_darwin_arm64", constraint_values = ["@platforms//os:osx", "@platforms//cpu:aarch64"])
config_setting(name = "node_is_darwin_amd64", constraint_values = ["@platforms//os:osx", "@platforms//cpu:x86_64"])
config_setting(name = "node_is_linux_arm64", constraint_values = ["@platforms//os:linux", "@platforms//cpu:aarch64"])
config_setting(name = "node_is_linux_amd64", constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"])

node_binding_test(
    name = "node_binding_test",
    target_under_test = ":node",
    native = select({
        ":node_is_darwin_arm64": "@nodejs_darwin_arm64//:node_bin",
        ":node_is_darwin_amd64": "@nodejs_darwin_amd64//:node_bin",
        ":node_is_linux_arm64": "@nodejs_linux_arm64//:node_bin",
        ":node_is_linux_amd64": "@nodejs_linux_amd64//:node_bin",
    }),
    original = select({
        ":node_is_darwin_arm64": "@nodejs_darwin_arm64//:npm_files",
        ":node_is_darwin_amd64": "@nodejs_darwin_amd64//:npm_files",
        ":node_is_linux_arm64": "@nodejs_linux_arm64//:npm_files",
        ":node_is_linux_amd64": "@nodejs_linux_amd64//:npm_files",
    }),
    resources = select({
        ":node_is_darwin_arm64": ["@nodejs_darwin_arm64//:npm_files"],
        ":node_is_darwin_amd64": ["@nodejs_darwin_amd64//:npm_files"],
        ":node_is_linux_arm64": ["@nodejs_linux_arm64//:npm_files"],
        ":node_is_linux_amd64": ["@nodejs_linux_amd64//:npm_files"],
    }),
)
