+    int capacity = 16 * (int)sizeof(pid_t);
+    pid_t* children = NULL;
+    int bytes;
+    for (;;) {
+      pid_t* resized = (pid_t*)realloc(children, (size_t)capacity);
+      if (!resized) {
+        free(children);
+        children = NULL;
+        break;
+      }
+      children = resized;
+      /* Only enumerate this stopped child process's immediate descendants. */
+      bytes = proc_listpids(PROC_PPID_ONLY, (uint32_t)process_id,
+                           children, capacity);
+      if (bytes < capacity) {
+        int index;
+        for (index = 0; index < bytes / (int)sizeof(pid_t); ++index) {
+          if (children[index] > 0 && children[index] != process_id) {
+            kwsysProcessKill(children[index]);
+          }
+        }
+        break;
+      }
+      if (capacity > INT_MAX / 2) {
+        break;
+      }
+      capacity *= 2;
+    }
+    free(children);
+  }
