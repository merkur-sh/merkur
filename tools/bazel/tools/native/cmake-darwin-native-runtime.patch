diff --git a/Source/kwsys/SystemVersionDarwin.hxx b/Source/kwsys/SystemVersionDarwin.hxx
new file mode 100644
--- /dev/null
+++ b/Source/kwsys/SystemVersionDarwin.hxx
@@ -0,0 +1,64 @@
+/* Read the same public platform facts as sw_vers without a child process. */
+#pragma once
+
+#ifdef __APPLE__
+#  include <CoreFoundation/CoreFoundation.h>
+#  include <cstring>
+#  include <string>
+#  include <vector>
+
+inline bool kwsysSystemVersionDarwin(char const* argument, std::string& value)
+{
+  CFStringRef key;
+  if (std::strcmp(argument, "-productName") == 0) {
+    key = CFSTR("ProductName");
+  } else if (std::strcmp(argument, "-productVersion") == 0) {
+    key = CFSTR("ProductVersion");
+  } else if (std::strcmp(argument, "-buildVersion") == 0) {
+    key = CFSTR("ProductBuildVersion");
+  } else {
+    return false;
+  }
+  CFURLRef url = CFURLCreateWithFileSystemPath(
+    kCFAllocatorDefault,
+    CFSTR("/System/Library/CoreServices/SystemVersion.plist"),
+    kCFURLPOSIXPathStyle, false);
+  if (!url) {
+    return false;
+  }
+  CFReadStreamRef stream = CFReadStreamCreateWithFile(kCFAllocatorDefault, url);
+  CFRelease(url);
+  if (!stream) {
+    return false;
+  }
+  if (!CFReadStreamOpen(stream)) {
+    CFRelease(stream);
+    return false;
+  }
+  CFPropertyListRef plist = CFPropertyListCreateWithStream(
+    kCFAllocatorDefault, stream, 0, kCFPropertyListImmutable, nullptr, nullptr);
+  CFReadStreamClose(stream);
+  CFRelease(stream);
+  if (!plist) {
+    return false;
+  }
+  bool success = false;
+  if (CFGetTypeID(plist) == CFDictionaryGetTypeID()) {
+    CFTypeRef field = CFDictionaryGetValue(static_cast<CFDictionaryRef>(plist), key);
+    if (field && CFGetTypeID(field) == CFStringGetTypeID()) {
+      CFStringRef text = static_cast<CFStringRef>(field);
+      CFIndex size = CFStringGetMaximumSizeForEncoding(
+        CFStringGetLength(text), kCFStringEncodingUTF8);
+      if (size >= 0) {
+        std::vector<char> buffer(static_cast<std::size_t>(size) + 1);
+        if (CFStringGetCString(text, buffer.data(), buffer.size(), kCFStringEncodingUTF8)) {
+          value.assign(buffer.data());
+          success = true;
+        }
+      }
+    }
+  }
+  CFRelease(plist);
+  return success;
+}
+#endif
