# Explicit source producers; runtime entry points remain subject to qualification.
declared_git_sdk(
    name = "source_git_darwin_arm64",
    source = "@git_declared_shell_source//:source",
    sdk = ":build_bash_darwin_arm64",
    make = ":build_make_darwin_arm64",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:aarch64"],
)

# Ledger acquisition runs its credential helper through Git's compiled `sh`, which only
# the source-built SDK provides as a real bin member.
[
    git_sdk_tool(
        name = "source_" + tool + "_tool_darwin_arm64",
        sdk = ":source_git_darwin_arm64",
        tool = tool,
        tags = ["manual"],
        target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:aarch64"],
    )
    for tool in ["git", "sh"]
]

[
    alias(
        name = "source_" + tool,
        actual = select({":darwin_arm64": ":source_" + tool + "_tool_darwin_arm64"}, no_match_error = "The source-built Git SDK requires this platform's declared Darwin compiler"),
    )
    for tool in ["git", "sh"]
]

