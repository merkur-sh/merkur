    make_driver = "//tools/bazel/rust:declared_cmake_driver_make",
    git = ":source_git_darwin_arm64",
    target = "aarch64-apple-darwin",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:aarch64"],
)

