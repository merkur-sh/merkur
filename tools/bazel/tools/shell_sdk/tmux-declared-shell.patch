+/* The verification engine's shell is an explicit declared runtime input. */
+const char *
+tmux_declared_shell(void)
+{
+	const char *shell = getenv("MERKUR_TMUX_SHELL");
+
+	if (shell == NULL || shell[0] != '/' || access(shell, X_OK) != 0) {
+		fprintf(stderr, "tmux requires the executable declared MERKUR_TMUX_SHELL\n");
+		exit(1);
+	}
+	return (shell);
+}
+
 static const char *
 getshell(void)
 {
-	struct passwd	*pw;
-	const char	*shell;
-
-	shell = getenv("SHELL");
-	if (checkshell(shell))
-		return (shell);
-
-	pw = getpwuid(getuid());
-	if (pw != NULL && checkshell(pw->pw_shell))
-		return (pw->pw_shell);
-
-	return (_PATH_BSHELL);
+	return (tmux_declared_shell());
 }
 
