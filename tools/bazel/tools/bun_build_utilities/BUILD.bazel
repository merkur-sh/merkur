load("//tools/bazel/packaging:rules.bzl", "package_controls_test")

package(default_visibility = ["//visibility:public"])

exports_files(["bash-source-build.py", "bash-runtime-resources.patch", 
    "source.bzl",
    "source-build.py",
    "source-build-test.py",
    "pins.json",
    "perl-declared-tools.patch",
    "nasm-declared-tools.patch",
])

filegroup(name = "verification_inputs", srcs = glob(["**"], exclude = [".*", "**/.*", ".*/**", "**/.*/**", "__pycache__/**", "**/__pycache__/**", "*.pyc", "**/*.pyc", ".env", ".env.*", "**/.env", "**/.env.*", ".bazelrc.local", "**/.bazelrc.local", ".DS_Store", "**/.DS_Store"]))

package_controls_test(
    name = "source_build_test",
    src = "source-build-test.py",
    data = ["source-build.py", "bash-source-build.py"],
    tags = ["manual", "unqualified-native-tool-matrix"],
