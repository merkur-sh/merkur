load("//tools/bazel/bun:rules.bzl", "bun_test")
load(":engine.bzl", "bazel_engine", "engine_acquisition")

package(default_visibility = ["//visibility:public"])

exports_files(["extensions.bzl", "engine.MODULE.bazel", "engine.bzl"])
filegroup(name = "verification_inputs", srcs = glob(["*.bzl", "*.bazel", "*.ts", "*.md"]))

config_setting(name = "darwin_arm64", constraint_values = ["@platforms//os:osx", "@platforms//cpu:aarch64"])
config_setting(name = "darwin_x64", constraint_values = ["@platforms//os:osx", "@platforms//cpu:x86_64"])
config_setting(name = "linux_arm64", constraint_values = ["@platforms//os:linux", "@platforms//cpu:aarch64"])
config_setting(name = "linux_x64", constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"])

bazel_engine(name = "darwin_arm64_engine", binary = "@bazel_engine_darwin_arm64//file", acquisition = "@bazel_engine_metadata//:darwin-arm64.json", target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:aarch64"])
bazel_engine(name = "darwin_x64_engine", binary = "@bazel_engine_darwin_x86_64//file", acquisition = "@bazel_engine_metadata//:darwin-x86_64.json", target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:x86_64"])
bazel_engine(name = "linux_arm64_engine", binary = "@bazel_engine_linux_arm64//file", acquisition = "@bazel_engine_metadata//:linux-arm64.json", target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64"])
bazel_engine(name = "linux_x64_engine", binary = "@bazel_engine_linux_x86_64//file", acquisition = "@bazel_engine_metadata//:linux-x86_64.json", target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])

alias(name = "bazel", actual = select({
    ":darwin_arm64": ":darwin_arm64_engine",
    ":darwin_x64": ":darwin_x64_engine",
    ":linux_arm64": ":linux_arm64_engine",
    ":linux_x64": ":linux_x64_engine",
}, no_match_error = "Bazel requires a declared native Darwin/Linux ARM64/x64 platform"))

engine_acquisition(name = "acquisition", engine = ":bazel")

bun_test(
    name = "engine_test",
    data = ["engine.test.ts", ":acquisition", "//:.github/bazel/engine-pins.json"],
    test_files = ["tools/bazel/tools/engine/engine.test.ts"],
    tools = {":bazel": "bazel"},
    tool_environment = {"bazel": "MERKUR_VERIFICATION_BAZEL"},
    environment_files = {":acquisition": "MERKUR_VERIFICATION_BAZEL_ACQUISITION"},
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
    tags = ["manual", "unqualified-native-tool-matrix"],
    timeout = "short",
)
