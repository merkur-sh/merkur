load(":wasm-test.bzl", "wasm_cipher_test")
load("//tools/bazel/bun:rules.bzl", "bun_test")
load(":rules.bzl", "wasm_bindgen_toolchain", "repository_input_tree")
load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

exports_files(["wasm-test.bzl", "wasm-test.ts", "wasm-test.test.ts", "wasm-test-controls.py"])

bun_test(
    name = "wasm_test_boundary_test",
    test_files = ["tools/bazel/wasm/wasm-test.test.ts"],
    data = [":wasm-test.bzl", ":wasm-test.ts", ":wasm-test.test.ts", ":wasm-test-controls.py"],
    tools = {"//tools/bazel/tools/native:python3": "python3"},
    tool_environment = {"python3": "MERKUR_WASM_TEST_CONTROL_PYTHON"},
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
)

filegroup(name = "verification_inputs", srcs = glob(["**"], exclude = ["node_modules/**", "dist/**", "target/**", "pkg/**", "**/pkg/**", "**/__pycache__/**", "**/*.pyc", "test-results/**", ".git/**", ".codegraph/**", ".tools/**", ".cache/**", "coverage/**", ".vite/**", ".env", ".env.*", "**/.env", "**/.env.*", ".bazelrc.local", "**/.bazelrc.local", "**/.DS_Store", ".DS_Store", ".*", ".*/**", "**/.*", "**/.*/**"], allow_empty = True) + glob(["**/.env.example", "**/.env.sample", "**/.env.template"], allow_empty = True))

exports_files(["rules.bzl", "extensions.bzl", "wasm.MODULE.bazel", "train-profile.ts", "project.ts", "optimize.ts", "package.ts", "input-tree.ts", "project-sources.ts", "project-sources.test.ts"])

js_library(name = "profile_trainer", srcs = ["train-profile.ts"], deps = ["//packages/shared:sources", "//scripts:raw_sources", "//:js_configuration"])
js_library(name = "package_runner", srcs = ["package.ts"], deps = ["//scripts:raw_sources", "//:js_configuration"])
js_library(name = "optimizer_runner", srcs = ["optimize.ts"])
js_library(name = "input_tree_runner", srcs = ["input-tree.ts", "project-sources.ts", "project-sources.test.ts"], deps = ["//tools/bazel/bun:owned_files_sources"])
repository_input_tree(name = "input_tree_fixture", srcs = ["fixtures/input-tree/one.txt", "fixtures/input-tree/nested/two.txt"])

toolchain_type(name = "toolchain_type")

wasm_bindgen_toolchain(name = "darwin_aarch64_runtime", bindgen = "@wasm_bindgen_darwin_aarch64//:wasm-bindgen", test_runner = "@wasm_bindgen_darwin_aarch64//:wasm-bindgen-test-runner", optimizer = "@binaryen_darwin_aarch64//:bin/wasm-opt", optimizer_files = "@binaryen_darwin_aarch64//:runtime_files")
wasm_bindgen_toolchain(name = "darwin_x64_runtime", bindgen = "@wasm_bindgen_darwin_x64//:wasm-bindgen", test_runner = "@wasm_bindgen_darwin_x64//:wasm-bindgen-test-runner", optimizer = "@binaryen_darwin_x64//:bin/wasm-opt", optimizer_files = "@binaryen_darwin_x64//:runtime_files")
wasm_bindgen_toolchain(name = "linux_aarch64_runtime", bindgen = "@wasm_bindgen_linux_aarch64//:wasm-bindgen", test_runner = "@wasm_bindgen_linux_aarch64//:wasm-bindgen-test-runner", optimizer = "@binaryen_linux_aarch64//:bin/wasm-opt", optimizer_files = "@binaryen_linux_aarch64//:runtime_files")
wasm_bindgen_toolchain(name = "linux_x64_runtime", bindgen = "@wasm_bindgen_linux_x64//:wasm-bindgen", test_runner = "@wasm_bindgen_linux_x64//:wasm-bindgen-test-runner", optimizer = "@binaryen_linux_x64//:bin/wasm-opt", optimizer_files = "@binaryen_linux_x64//:runtime_files")

toolchain(name = "darwin_aarch64", toolchain = ":darwin_aarch64_runtime", toolchain_type = ":toolchain_type", exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"])
toolchain(name = "darwin_x64", toolchain = ":darwin_x64_runtime", toolchain_type = ":toolchain_type", exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:x86_64"])
toolchain(name = "linux_aarch64", toolchain = ":linux_aarch64_runtime", toolchain_type = ":toolchain_type", exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64"])
toolchain(name = "linux_x64", toolchain = ":linux_x64_runtime", toolchain_type = ":toolchain_type", exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"])

bun_test(name = "static_projection_test", test_files = ["tools/bazel/wasm/project-sources.test.ts"], data = [":input_tree_runner"], bun_config = "//tools/bazel/bun:empty-bunfig.toml", tags = ["external", "no-cache"])

exports_files(["providers.bzl"])

exports_files(["selected-attribution.bzl", "selected-attribution.py", "selected-attribution-test.py", "selected-attribution.test.ts", "generator-licenses-test.py"])

# Original synthetic custody controls; this target does not qualify WASM runtimes.
bun_test(
    name = "selected_attribution_test",
    test_files = ["tools/bazel/wasm/selected-attribution.test.ts"],
    data = [
        ":selected-attribution.test.ts",
        ":frontend-check.ts",
        "//tools/bazel/bun:npm-attribution.ts",
        "//tools/bazel/bun:compiler-inventory.ts",
        "//tools/bazel/bun:owned-files.ts",
        "//tools/bazel/bun:portable-path.ts",
        "//tools/bazel/bun:empty-bunfig.toml",
        "//tools/bazel/packaging:rust-link-map.bzl",
        ":selected-attribution-test.py",
        ":selected-attribution.py",
        ":generator-licenses-test.py",
        "//tools/bazel/packaging:wasm-inputs.py",
        "//tools/bazel/packaging:rust-license-metadata-test.py",
        "//tools/bazel/packaging:rust-license-metadata.py",
        "//tools/bazel/packaging:deployment-pack.py",
        "//tools/bazel/packaging:deployment-notices.py",
        "//tools/bazel/packaging:npm-notices.py",
        "//tools/bazel/packaging:pack.py",
        "//tools/bazel/packaging:license-inputs.py",
        "//tools/bazel/packaging:license-closure.py",
        "//tools/bazel/packaging:rust-notices.py",
        "//tools/bazel/rust:units.py",
        "//tools/bazel/rust:configured_parity.py",
        "//tools/bazel/rust:license_metadata.py",
        "//tools/bazel/rust:native_receipts.py",
        "//tools/bazel/rust:stdlib_attribution.py",
    ],
    tools = {"//tools/bazel/tools/native:python3": "python3"},
    tool_environment = {"python3": "MERKUR_SELECTED_WASM_PYTHON"},
    bun_config = "//tools/bazel/bun:empty-bunfig.toml",
)

wasm_cipher_test(
    name = "wasm_cipher",
    harness = "//tools/bazel/rust/protocol_wasm:u_9ce0b7625f30e1cfa7ee9f897f40a3fc4eb56636dcffe3089198a6f9c800302c_binary",
    target_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    tags = ["manual"],
)

# This resolves analysis for the original rust_test compilation dependency.
# It does not make a native executor capable of executing a raw WASM binary.
# Only //tools/bazel/wasm:wasm_cipher supplies the declared Node test runtime.
toolchain(
    name = "wasm_harness_placement_darwin_arm64",
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
    target_compatible_with = ["@platforms//os:none", "@platforms//cpu:wasm32"],
    exec_compatible_with = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
    visibility = ["//visibility:public"],
)

exports_files(["frontend-check.ts"])
