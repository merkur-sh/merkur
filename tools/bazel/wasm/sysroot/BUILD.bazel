load("//tools/bazel:files.bzl", "package_files")

package_files()

# The wasm32 C toolchain's sysroot, which holds nothing: what C a wasm32 crate compiles needs no C
# library, as zstd-sys brings its own shim headers.
filegroup(
    name = "sysroot",
    srcs = [],
    visibility = ["//visibility:public"],
)
