load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("@term_wasm_crates//:defs.bzl", "aliases", "all_crate_deps")
load(":crates.bzl", "MODULE_DEPS", "module_crates")
load("//tools/bazel/wasm:defs.bzl", "wasm_module", "wasm_package", "wasm_profile")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The module's own workspace (`scripts/wasm-artifact-manifests.ts`), which its hub resolves.
exports_files([
    "Cargo.lock",
    "Cargo.toml",
] + glob(["crates/*/Cargo.toml"]))

module_crates()

# The terminal the browser runs, its crates resolved for it alone. The training build compiles its training entry points
# and links minicov's profile runtime.
rust_shared_library(
    name = "term_wasm",
    srcs = ["//packages/term-wasm:srcs"],
    aliases = aliases(),
    compile_data = ["//apps/web:fonts"],
    crate_features = select({
        "//tools/bazel/wasm:instrumented_build": ["pgo-train"],
        "//conditions:default": [],
    }),
    crate_root = "//packages/term-wasm:src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    target_compatible_with = ["@platforms//cpu:wasm32"],
    version = "0.1.0",
    deps = MODULE_DEPS + all_crate_deps(normal = True),
)

wasm_module(
    name = "instrumented",
    crate = ":term_wasm",
    instrumented = True,
    simd128 = True,
)

# Trained on the ingress benchmark's raw frames and their MZ-coded twins
# (`scripts/term-wasm-pgo-stream.ts`, `scripts/term-wasm-pgo.ts`).
wasm_profile(
    name = "profile",
    font = "//apps/web:public/fonts/JetBrainsMonoNF-Regular.ttf",
    instrumented = ":instrumented",
    stream_builder = "//scripts:term_wasm_pgo_stream",
    trainer = "//scripts:term_wasm_pgo",
    display_fixture = "//packages/display-fixture",
)

wasm_module(
    name = "module",
    crate = ":term_wasm",
    profile = ":profile",
    simd128 = True,
)

[wasm_package(
    name = name,
    glue = "//scripts:term_wasm_current_glue",
    license = "AGPL-3.0-only",
    module = module,
    out_name = "term_wasm",
    package_name = "term-wasm",
    version = "0.1.0",
) for name, module in [
    ("pkg", ":module"),
    ("pkg_unprofiled", ":module_unprofiled"),
]]

# The same module without the profile, which the tests load (`//tools/bazel/wasm:profiled`).
wasm_module(
    name = "module_unprofiled",
    crate = ":term_wasm",
    simd128 = True,
)

# The package where the TypeScript imports it from: the shipped one in what ships, the
# unprofiled one everywhere else.
alias(
    name = "imported_pkg",
    actual = select({
        "//tools/bazel/wasm:profiled_build": ":pkg",
        "//conditions:default": ":pkg_unprofiled",
    }),
)
