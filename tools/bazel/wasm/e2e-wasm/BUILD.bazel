load("@e2e_wasm_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load(":crates.bzl", "MODULE_DEPS", "module_crates")
load("//tools/bazel/wasm:defs.bzl", "wasm_module", "wasm_package")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The module's own workspace (`scripts/wasm-artifact-manifests.ts`), which its hub resolves.
exports_files([
    "Cargo.lock",
    "Cargo.toml",
] + glob(["crates/*/Cargo.toml"]))

module_crates()

# The browser's Noise transport and session authorization, its crates resolved for it alone.
rust_shared_library(
    name = "e2e_wasm",
    srcs = ["//packages/e2e-wasm:srcs"],
    aliases = aliases(),
    crate_root = "//packages/e2e-wasm:src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    target_compatible_with = ["@platforms//cpu:wasm32"],
    version = "0.1.0",
    deps = MODULE_DEPS + all_crate_deps(normal = True),
)

# SIMD although chacha20 has no wasm backend for it: measured on `bench:e2e-display-open`, open
# cost falls ~15% at 16-60 KiB and ~10% at 1 KiB.
wasm_module(
    name = "module",
    crate = ":e2e_wasm",
    simd128 = True,
)

wasm_package(
    name = "pkg",
    license = "AGPL-3.0-only",
    module = ":module",
    out_name = "e2e_wasm",
    package_name = "e2e-wasm",
    version = "0.1.0",
)
