load("@graphics_codec_probe_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load(":crates.bzl", "MODULE_DEPS", "module_crates")
load("//tools/bazel/wasm:defs.bzl", "wasm_module", "wasm_package")
load("//tools/bazel:files.bzl", "package_files")

package(default_visibility = ["//visibility:public"])

package_files()

# The module's own workspace (`scripts/wasm-artifact-manifests.ts`), which its hub resolves.
exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

module_crates()

# The graphics codec benchmark's browser probe, its crates resolved for it alone.
rust_shared_library(
    name = "graphics_codec_probe",
    srcs = ["//packages/graphics-codec-probe:srcs"],
    aliases = aliases(),
    crate_root = "//packages/graphics-codec-probe:src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    target_compatible_with = ["@platforms//cpu:wasm32"],
    version = "0.1.0",
    deps = MODULE_DEPS + all_crate_deps(normal = True),
)

wasm_module(
    name = "module",
    crate = ":graphics_codec_probe",
)

wasm_package(
    name = "pkg",
    license = "AGPL-3.0-only",
    module = ":module",
    out_name = "graphics_codec_probe",
    package_name = "graphics-codec-probe",
    version = "0.1.0",
)
