# The Apple compiler/SDK is the pinned export of Xcode 26.5 (17F42), read from the
# machine-local store named by MERKUR_DARWIN_COMPILER_STORE; Apple's licence forbids publishing it.
darwin_compilers = use_extension("//tools/bazel/tools/native:darwin-extension.bzl", "darwin_compilers")
darwin_compilers.compiler(
    platform = "darwin_arm64",
    specification = "//tools/bazel/tools/native:darwin-compiler-arm64.json",
    deployment_target = "11.0",
    executor_constraints = ["//tools/bazel/cc/native:xcode_26_5_17f42"],
)
use_repo(darwin_compilers, "compiler_darwin_arm64", "darwin_registration")
register_execution_platforms("@darwin_registration//:execution")
register_toolchains("@darwin_registration//:all")

cmake_distributions = use_extension("//tools/bazel/tools/native:cmake.bzl", "cmake_distributions")
use_repo(cmake_distributions, "cmake_darwin_arm64", "cmake_darwin_x64", "cmake_linux_arm64", "cmake_linux_x64", "cmake_source", "cmake_source_archive")

vite_source = use_extension("//tools/bazel/bun:vite-source.bzl", "vite_source")
