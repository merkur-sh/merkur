module(name = "merkur")

bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "openssl", version = "3.5.8.bcr.0")
bazel_dep(name = "redis", version = "8.6.2.bcr.1")

# The Redis server the scripts' preflight tests run against, with the TLS they test.
single_version_override(
    module_name = "redis",
    patch_strip = 1,
    patches = ["//tools/bazel/redis:redis-tls.patch"],
    version = "8.6.2.bcr.1",
)
# rules_swift reaches the graph through rules_js, protobuf and rules_apple, and registers a toolchain
# whose repository runs the host's Swift compiler to probe it: 29 s on a Linux runner, before any
# other toolchain resolves. Nothing here builds with rules_swift (the Secure Enclave bridge compiles
# with Xcode's tools), so the toolchain stays unregistered and the probe never runs.
single_version_override(
    module_name = "rules_swift",
    patch_strip = 1,
    patches = ["//tools/bazel:rules_swift-unregistered-toolchain.patch"],
    version = "3.1.2",
)
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "toolchains_llvm", version = "1.11.3")
bazel_dep(name = "with_cfg.bzl", version = "1.0.1")

# `@rules_rust//rust/settings:profile_use` names the LLVM profile every non-exec crate and its
# build scripts' C optimize with, as Cargo's `-Cprofile-use` rustflags do
# (`//tools/bazel/wasm/term-wasm:profile`).
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//tools/bazel/rust:rules_rust-profile-use.patch",
        "//tools/bazel/rust:rules_rust-local-crate-mirror.patch",
    ],
    version = "0.74.0",
)

# Rust: the version `rust-toolchain.toml` names; `scripts/toolchain-pins.test.ts` holds the
# two equal. `fastbuild`, which `bazel test` uses, is Cargo's test profile: opt-level 1 with
# assertions on (`.bazelrc`); `opt` is the release profile.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    # SSSE3 is the x86_64 CPU floor: merkur-fec's one x86_64 SIMD lane is `pshufb`, and the crate
    # refuses to compile without it.
    # getrandom picks no entropy source for wasm32-unknown-unknown on its own; the browser's
    # is `crypto.getRandomValues`.
    extra_rustc_flags_triples = {
        "wasm32-unknown-unknown": ['--cfg=getrandom_backend="wasm_js"'],
        "x86_64-apple-darwin": ["-Ctarget-feature=+ssse3"],
        "x86_64-unknown-linux-gnu": ["-Ctarget-feature=+ssse3"],
    },
    extra_target_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
    opt_level = {
        "dbg": "0",
        "fastbuild": "1",
        "opt": "3",
    },
    sha256s = {
        "cargo-1.99.0-aarch64-apple-darwin.tar.xz": "76abff0ad79a10a3152dff640ea0d8b3c37637d9300bf55da41b95c3ddc069c1",
        "cargo-1.99.0-aarch64-unknown-linux-gnu.tar.xz": "113229fcc16cc1ba004923a4cc275fbf3281dafaaf8b97269f9c00189d497fd4",
        "cargo-1.99.0-x86_64-apple-darwin.tar.xz": "939b71952afd63ae73bc00f3517c19f0dd7ac54884b5fac16a813ee50985d14d",
        "cargo-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "d7674918d28093097614cd9728b6ca60db9ea3038f640f0bd1e9a4188c7568ce",
        "clippy-1.99.0-aarch64-apple-darwin.tar.xz": "c31a0765ed31d98515a09a13b44486048873d90ac75bb1e6690a17fb36a5d4e2",
        "clippy-1.99.0-aarch64-unknown-linux-gnu.tar.xz": "42e49dc02d29949395c0c072585961f6c9b5408110236087828d4e2f94ca96ef",
        "clippy-1.99.0-x86_64-apple-darwin.tar.xz": "cd93518193f16b21cfa7147a42cb03cd2d9ca9b3d0c2daf46dcae44c88a696df",
        "clippy-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "982442e32ad8dd3f0bb3a30db74038da5f71fd9bf1a865cc71da8ea5d4ec71ec",
        "llvm-tools-1.99.0-aarch64-apple-darwin.tar.xz": "9cbaa83827e53c9bbae05fa3a36aff0832448de6d2204829b710cbc85567ad2d",
        "llvm-tools-1.99.0-aarch64-unknown-linux-gnu.tar.xz": "6e921c7c1225ec43dcdd0bda2ce541ac79d45eaa2da64c686f7d78e8cb3dff04",
        "llvm-tools-1.99.0-x86_64-apple-darwin.tar.xz": "708b998c88ccbf2ce847cc8aeeb9fa55b969319848971a9e2085c8e426b907cf",
        "llvm-tools-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "91a6db5668c08ee68e330e5b0fda27c11b79b90592627e89f7c5db12af2ff0ba",
        "rust-std-1.99.0-aarch64-apple-darwin.tar.xz": "a7c6de8aa21e7c31163a7656295b321bb85f5dce55ed8ea95ac9ac561202bb5b",
        "rust-std-1.99.0-aarch64-unknown-linux-gnu.tar.xz": "1cf7e2ef58ed1cfa6f1adea18e155cbf254c1951f39e5f5e3376879f55fd64a4",
        "rust-std-1.99.0-wasm32-unknown-unknown.tar.xz": "b760b0c9b08a6843c05de0098bd6802e23178ff473c4715ae57c1d679125bf22",
        "rust-std-1.99.0-x86_64-apple-darwin.tar.xz": "18ee81961a73c3ae966ecb1e8f6096438c90aeefece8856201a6ecc17f5bc850",
        "rust-std-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "3e58dff2d0b72196b5ea4e90536e174d400de88564a52694686b81e091169933",
        "rustc-1.99.0-aarch64-apple-darwin.tar.xz": "334a66714ca316d71bbe5efe44f71762d0b276cea73be2987374693a837f7450",
        "rustc-1.99.0-aarch64-unknown-linux-gnu.tar.xz": "89c0f1a3a44df63c95e5d5f2ba093d0a12c5f5f57f8635f8a7a0ce50cf86600e",
        "rustc-1.99.0-x86_64-apple-darwin.tar.xz": "7460910254f059b49b99ee3ddbcf7197d16b9505b59c166e14a1465ee323a81d",
        "rustc-1.99.0-x86_64-unknown-linux-gnu.tar.xz": "77171ba2a0345fdf2abc4fedda55d6de078dae7a68527c28be8c77dcc9604bd5",
    },
    versions = ["1.99.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates resolve from the workspace manifests and `Cargo.lock`, which stay the source
# of truth; the `[patch.crates-io]` crates outside the workspace resolve as local mirrors.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)

# Each WebAssembly module the browser loads resolves its crates alone, in a workspace of its own
# (`scripts/wasm-artifact-manifests.ts`): the workspace's hub unifies test-only features and
# native backends into crates the module shares with the daemon.
include("//tools/bazel/wasm:hubs.MODULE.bazel")

# The network simulator links the production crates against turmoil and tokio's `test-util`,
# so it resolves from a workspace of its own too (`scripts/sim-workspace.ts`).
include("//tools/bazel/sim:hub.MODULE.bazel")

# The vendored transport crates' own tests, with the dev-dependencies the release workspace leaves
# out, resolve from a workspace of their own (`scripts/vendored-workspace.ts`).
include("//tools/bazel/vendored:hub.MODULE.bazel")

# minicov compiles LLVM's profile runtime for the training build with whatever `clang` its PATH
# holds; this has it take the C toolchain cc-rs is given, like every other build script.
crate.annotation(
    crate = "minicov",
    patch_args = ["-p1"],
    patches = ["//tools/bazel/wasm:minicov-cc-toolchain.patch"],
    repositories = ["term_wasm_crates"],
)

# The diagnostic and proof tools are workspaces of their own, which never join the release lock:
# the ownership proofs' Loom models and the edge's kernel profiler.
[crate.from_cargo(
    name = name,
    cargo_lockfile = "//tools/%s:Cargo.lock" % directory,
    manifests = ["//tools/%s:Cargo.toml" % directory],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
) for name, directory in [
    ("edge_kernel_profile_crates", "edge-kernel-profile"),
    ("ownership_proofs_crates", "ownership-proofs"),
]]

use_repo(crate, "crates", "edge_kernel_profile_crates", "ownership_proofs_crates")

# C and C++: one LLVM for every target, the major rustc 1.99.0 is built on. Linux links against
# a Debian bullseye sysroot (glibc 2.31), so a binary built on any host runs on any supported
# Linux.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    # wasm32 C compiles as cc-rs compiles it under Cargo's release profile: at -O3, with no stack
    # protector and no fortified libc calls (there is no libc). These follow the defaults, so
    # they win.
    compile_flags = {"wasm32": ["-fno-stack-protector"]},
    llvm_version = "23.1.3",
    opt_compile_flags = {"wasm32": [
        "-O3",
        "-U_FORTIFY_SOURCE",
    ]},
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:sysroot",
    targets = ["linux-aarch64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "//tools/bazel/wasm/sysroot",
    targets = ["wasm32"],
)

# The release LLVM for the host the build runs on, cut to what the toolchain uses: the archives
# `scripts/llvm-distribution.ts` writes and publishes (`tools/bazel/llvm/distribution.bzl`).
llvm_distribution = use_repo_rule("//tools/bazel/llvm:distribution.bzl", "llvm_distribution")

[llvm_distribution(
    name = "llvm_" + host.replace("-", "_"),
    platform = platform,
    sha256 = sha256,
    version = "23.1.3",
) for host, platform, sha256 in [
    ("darwin-aarch64", "macOS-ARM64", "067084d0f31a1cdbd34a2e3cc6ca72306e68fe7d598972e355a703b5f51807ee"),
    ("linux-aarch64", "Linux-ARM64", "6953499a49b04cd2d9a4ca4f8d859579a3d6a5b7951a6865631619083449ef54"),
    ("linux-x86_64", "Linux-X64", "7336edfb18d0940ec8e319fef24c0cf7ff3d6508234b6b9ae805a5d367fef842"),
]]

[llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_%s//:BUILD.bazel" % host.replace("-", "_"),
    targets = [host],
) for host in ["darwin-aarch64", "linux-aarch64", "linux-x86_64"]]

use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# What a compiler and linker read from a sysroot: its headers and libraries.
_SYSROOT_BUILD = '''filegroup(
    name = "sysroot",
    srcs = glob(
        ["lib/**", "lib64/**", "usr/include/**", "usr/lib/**", "usr/lib64/**"],
        exclude = ["lib/systemd/**", "usr/lib/systemd/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
'''

http_archive(
    name = "sysroot_linux_aarch64",
    build_file_content = _SYSROOT_BUILD,
    sha256 = "63b2bcd2a1800a143d51590784bb84caa98a695cf65614364968a8be9cd31173",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/63b2bcd2a1800a143d51590784bb84caa98a695cf65614364968a8be9cd31173"],
    type = "tar.xz",
)

http_archive(
    name = "sysroot_linux_x86_64",
    build_file_content = _SYSROOT_BUILD,
    sha256 = "aa2b968052fa851240b70e941de1b680459b8b19ab10763077ad13e625f81d22",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/aa2b968052fa851240b70e941de1b680459b8b19ab10763077ad13e625f81d22"],
    type = "tar.xz",
)

# JavaScript: every package `pnpm-lock.yaml` resolves, linked per workspace project as pnpm links
# it. Nothing runs a package's install script, as nothing does in a `pnpm install` here
# (`onlyBuiltDependencies` is empty).
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    lifecycle_hooks = {"*": []},
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

# Node, which the tests that measure V8 and run wasm-bindgen's test harness spawn, at the release
# `.node-version` names (`scripts/toolchain-pins.test.ts`).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_repositories = {
        "26.11.1-darwin_arm64": ["node-v26.11.1-darwin-arm64.tar.xz", "node-v26.11.1-darwin-arm64", "0ef9b443000681bffc062ec126d53f97933ea9b086ea73dcba0480d87e639b39"],
        "26.11.1-darwin_amd64": ["node-v26.11.1-darwin-x64.tar.xz", "node-v26.11.1-darwin-x64", "68a8a4de0c46e693a261d13efb43d041fcd7386187816ef9a4b14bf60003adb2"],
        "26.11.1-linux_arm64": ["node-v26.11.1-linux-arm64.tar.xz", "node-v26.11.1-linux-arm64", "0945e2cde6aa0f54d980f03874dfe5cf3a549ce714c7fb9019e591ce0accf282"],
        "26.11.1-linux_amd64": ["node-v26.11.1-linux-x64.tar.xz", "node-v26.11.1-linux-x64", "3883bfc73f9a680ca4eab04b196068aaaab1373ffa77d8fc1a4408222495b651"],
    },
    node_version_from_nvmrc = "//:.node-version",
)

# Target-platform runtime files for isolated Linux harnesses built from macOS.
use_repo(node, "nodejs_darwin_arm64", "nodejs_darwin_amd64", "nodejs_linux_arm64", "nodejs_linux_amd64")

# Bun, the runtime and test runner, at the release `.bun-version` names
# (`scripts/toolchain-pins.test.ts`).
bun = use_extension("//tools/bazel/bun:extensions.bzl", "bun")
use_repo(bun, "bun_darwin_aarch64", "bun_darwin_x64", "bun_linux_aarch64", "bun_linux_x64")

# wasm-bindgen's CLI and binaryen's `wasm-opt`, for the browser's WebAssembly packages.
wasm_tools = use_extension("//tools/bazel/wasm:extensions.bzl", "wasm_tools")
use_repo(
    wasm_tools,
    "binaryen_darwin_aarch64",
    "binaryen_darwin_x64",
    "binaryen_linux_aarch64",
    "binaryen_linux_x64",
    "wasm_bindgen_darwin_aarch64",
    "wasm_bindgen_darwin_x64",
    "wasm_bindgen_linux_aarch64",
    "wasm_bindgen_linux_x64",
)

# The vendored transport crates, which Bazel never loads as packages (`REPO.bazel`): their files
# for the checkouts the static gates and the scripts' tests read, and their sources for their own
# tests (`//tools/bazel/vendored`).
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

[new_local_repository(
    name = "vendored_" + crate.replace("-", "_"),
    build_file_content = """filegroup(
    name = "files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "target/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

exports_files(glob(["build.rs", "src/lib.rs"], allow_empty = True))
""",
    path = "packages/" + crate,
) for crate in [
    "quinn-patch",
    "quinn-proto-patch",
    "wtransport-patch",
]]

# The Chromium builds Playwright launches, at the revision `playwright-core` names.
playwright_browsers = use_extension("//tools/bazel/playwright:extensions.bzl", "playwright_browsers")
use_repo(
    playwright_browsers,
    "chromium_darwin_aarch64",
    "chromium_darwin_x64",
    "chromium_headless_shell_darwin_aarch64",
    "chromium_headless_shell_darwin_x64",
    "chromium_headless_shell_linux_aarch64",
    "chromium_headless_shell_linux_x64",
    "chromium_linux_aarch64",
    "chromium_linux_x64",
)
