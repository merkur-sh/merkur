# The frontend supplies an immutable fresh Git context through --override_repository.
# This default repository contains a refusal record, never synthetic successful facts.
verification_context_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
verification_context_repository(name = "verification_context", path = "tools/bazel/verification/context")

# A missing nonce is a refusal. The frontend supplies the captured authoritative epoch Files.
verification_context_repository(name = "verification_revocations", path = "tools/bazel/verification/revocations")

# Fresh audit bytes are bound by the frontend; the default pair always refuses.
verification_context_repository(name = "verification_audit", path = "tools/bazel/verification/audit-context")

# Original runtime archives are source inputs; acquisition does not qualify attribution.
runtime_archives = use_extension("//tools/bazel/bun:runtime-archives.bzl", "runtime_archives")
use_repo(runtime_archives, "bun_profile_darwin_aarch64", "bun_profile_darwin_x64", "bun_profile_linux_aarch64", "bun_profile_linux_x64", "bun_webkit_darwin_aarch64", "bun_webkit_darwin_x64", "bun_webkit_linux_aarch64", "bun_webkit_linux_x64", "bun_icu_sources")

staged_scanners = use_extension("//tools/bazel/verification:staged-gates.bzl", "staged_scanners")
use_repo(staged_scanners, "trufflehog_darwin_arm64", "trufflehog_darwin_amd64", "trufflehog_linux_arm64", "trufflehog_linux_amd64")

# Import the already instantiated yq extension; do not register a duplicate default tag.
bazel_dep(name = "yq.bzl", version = "0.3.4")
yq = use_extension("@yq.bzl//yq:extensions.bzl", "yq")
use_repo(yq, "yq_darwin_amd64", "yq_darwin_arm64", "yq_linux_amd64", "yq_linux_arm64")

# Original prepared upstream sources and locked JS graph; no complete attribution is implied.
rolldown_source_repository = use_repo_rule("//tools/bazel/rust:rolldown_source.bzl", "rolldown_source_repository")
rolldown_source_repository(
    name = "merkur_rolldown_source",
    source_instances = "//tools/bazel/rust:rolldown-source-instances.json",
    source_instance = "workspace",
    source_inventory = "//tools/bazel/rust:rolldown_source_data.bzl",
    npm_repository = "merkur_rolldown_npm",
    patches = ["//tools/bazel/rust:rolldown-native-origin.patch", "//tools/bazel/rust:rolldown-native-preload.patch"],
    yq = {
        "@yq_darwin_arm64//:yq": "darwin_arm64",
        "@yq_darwin_amd64//:yq": "darwin_x64",
        "@yq_linux_arm64//:yq": "linux_arm64",
        "@yq_linux_amd64//:yq": "linux_x64",
    },
)

rolldown_source_repository(
