# Project-scoped Codex execpolicy allowlist. Mirrors permissions.allow in .claude/settings.json.
# Machine-specific rules stay in ~/.codex/rules/default.rules.
prefix_rule(pattern=["bun", "test"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:types"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:lint"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:latency-boundaries"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:span-lifetimes"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:span-attributes"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:dead"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:files"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:docs"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:protocol"], decision="allow")
prefix_rule(pattern=["bun", "run", "check:audit"], decision="allow")
prefix_rule(pattern=["bun", "run", "check"], decision="allow")
prefix_rule(pattern=["bun", "run", "gates"], decision="allow")
prefix_rule(pattern=["bun", "run", "generate:docs"], decision="allow")
prefix_rule(pattern=["bun", "run", "rust:lint"], decision="allow")
prefix_rule(pattern=["bun", "run", "sync:wasm"], decision="allow")
prefix_rule(pattern=["bun", "run", "build:wasm"], decision="allow")
prefix_rule(pattern=["bun", "run", "build:e2e-wasm"], decision="allow")
prefix_rule(pattern=["bun", "run", "verify"], decision="allow")
prefix_rule(pattern=["bun", "run", "test:unit"], decision="allow")
prefix_rule(pattern=["bun", "install"], decision="allow")
prefix_rule(pattern=["bunx", "biome", "check"], decision="allow")
prefix_rule(pattern=["bunx", "biome", "format"], decision="allow")
prefix_rule(pattern=["cargo", "test"], decision="allow")
prefix_rule(pattern=["cargo", "clippy"], decision="allow")
prefix_rule(pattern=["rustfmt"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "worktree", "list"], decision="allow")
prefix_rule(pattern=["codegraph"], decision="allow")
