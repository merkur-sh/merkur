# Deny by default. New build inputs must be deliberately admitted here.
**

# The server image (`Dockerfile`): the manifests its verifier's dependencies install from, the
# verifier, and the signed deployment. Preserve the COMPLETE signed directory, including
# unexpected files, so deployment:verify rejects additions instead of filtering them away.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!apps/*/package.json
!packages/*/package.json
!packages/shared/src/**/*.ts
!packages/shared/src/**/*.json
!packages/e2e-wasm/pkg/**
!scripts/web-build-signature.ts
!deployment/**

# The edge and STUN images: their entrypoints, which install egress caps and then drop
# privileges, and the release binaries Bazel built (`//tools/bazel/release:image_binaries`).
!apps/edge/entrypoint.sh
!apps/stun/entrypoint.sh
!dist/images/merkur-edge
!dist/images/merkur-stun

**/*.test.ts
